
@{
    ViewBag.Title = "ePaymentGenYearly";
    Layout = ViewBag.Layout;
}

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<link href="~/assets/css/custom.css" rel="stylesheet" />

@if (Session["Tin"] != null)
{
    <style>
        .container.payment, .container.Reports {
            /*padding: 150px 80px 30px !important;*/
        }
    </style>
}
else
{
    <style>
        .container.payment, .container.Reports {
            padding: 15px 80px 30px !important;
        }
    </style>
}
<body>


    <div class="container payment">
        <div class="body-content">
            <div class="payment-wrapper">
                <div class="section-title">PT e-Payment</div>
                <div class="payment-header" style="display:none;">
                    <div class="payment-icon">
                        <i class="fas fa-credit-card"></i>
                    </div>
                    <h2 class="payment-title">Profession Tax Payment Portal</h2>
                    <p class="payment-subtitle">Calculate and pay Profession Tax for your business and employees</p>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-id-card"></i>
                            PTIN / GRN <span style="color:red">*</span>
                        </label>
                        <input type="text" class="form-input" placeholder="Enter PTIN or GRN number" id="ptinInput" onchange="GetEnterpriseDeatils();">
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-building"></i>
                            Name of the Firm
                        </label>
                        <input type="text" class="form-input" placeholder="Enter registered firm name" id="firmNameInput" readonly>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-bullseye"></i>
                        Select Payment Purpose <span style="color:red">*</span>
                    </label>
                    <div class="radio-group">
                        <label class="radio-option">
                            <input type="radio" name="purpose" id="return_radio" onchange="onPurposeChange('1');" checked class="radio-input">
                            <span class="radio-label">Return Tax</span>
                        </label>

                        <label class="radio-option">
                            <input type="radio" name="purpose" id="oth_ret_radio" onchange="onPurposeChange('2');" class="radio-input">
                            <span class="radio-label">Other than Return Tax</span>
                        </label>
                        <label class="radio-option">
                            <input type="radio" name="purpose" id="oth_radio" onchange="onPurposeChange('3');" class="radio-input">
                            <span class="radio-label">Amount Payable by Others</span>
                        </label>
                        <div class="purpose-box" id="oth_ret_box">
                            <select class="form-select" id="othRetSelect" style="width: 56%;">
                                <option value="">-- Select Category --</option>
                                <option>Tax Demand Raised on Audit/Assessment</option>
                                <option>Interest Demand Raised on Audit/Assessment</option>
                                <option>Penalty Demand Raised on Audit/Assessment</option>
                                <option>Tax Voluntary Payment</option>
                                <option>Interest Voluntary Payment</option>
                                <option>Penalty Voluntary Payment</option>

                            </select>
                        </div>
                        <div class="purpose-box" id="oth_box">
                            <select class="form-select" id="othSelect" style="width: 56%;">
                                <option value="">-- Select Category --</option>
                                <option>TDS of Profession Tax by Insurer for Agents</option>
                                <option>Payment by Turf Club on behalf of Licensed Persons U/S 5A</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div id="divReturnTax">
                    @*<div class="tab-buttons" style="display:flex; gap:10px; margin-bottom:15px;">
                        <button type="button" class="tab-btn active" id="yearlytab" onclick="showPaymentTab('yearlyTab', this)">
                            <i class="fas fa-calendar-alt"></i> Yearly Demand
                        </button>
                    </div>*@
                    <div id="yearlyTab" class="payment-tab">
                        <div class="payment-section">
                            <div class="section-header">
                                <h3><i class="fas fa-calendar-alt"></i> Yearly Demand Information</h3>
                            </div>
                            <div style="padding: 18px;">
                                <div>
                                    <label>
                                        <i class="fas fa-calendar"></i>
                                        For The Financial Year
                                    </label>
                                    <select class="form-select" id="ddlYear" onchange="onYearChange();">
                                        <option value="0">--Select Year--</option>
                                    </select>
                                </div>

                                <p class="section-hint">Calculation: Number × Tax Per Annum = Amount</p>


                                <table style="width: 100%; border-collapse: collapse; border: 1px solid #dee2e6; border-radius: 8px; font-family: Arial, sans-serif;" id="tblYear">
                                    <thead>
                                        <tr style="background: linear-gradient(135deg, #600664, #75339b, #590568, #531f66);">
                                            <th style="padding: 15px; text-align: left; font-weight: 500; color: white; border-bottom: 2px solid #dee2e6; width: 40%;">Category</th>
                                            <th style="padding: 15px; text-align: left; font-weight: 500; color: white; border-bottom: 2px solid #dee2e6; width: 20%;">Number</th>
                                            <th style="padding: 15px; text-align: left; font-weight: 500; color: white; border-bottom: 2px solid #dee2e6; width: 20%;">Tax Per Annum (₹)</th>
                                            <th style="padding: 15px; text-align: left; font-weight: 500; color: white; border-bottom: 2px solid #dee2e6; width: 20%;">Amount (₹)</th>
                                        </tr>
                                    </thead>
                                    <tbody id="taxTableBody">
                                        <tr class="yearly-row" data-rate="2500" style="background-color: #ffffff;">
                                            <td style="padding: 12px 15px; border-bottom: 1px solid #e0e0e0;">
                                                <label class="checkbox-label" style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                                    @*<input type="checkbox" class="row-checkbox" id="chkFirmCompany" onchange="toggleFirm(this)" style="cursor: pointer;">*@
                                                    <i class="fas fa-building" style="color: #6c757d;"></i>
                                                    <span style="color: #495057;">Firm / Company / Proprietorship</span>
                                                </label>
                                            </td>
                                            <td style="padding: 8px 15px; border-bottom: 1px solid #e0e0e0;">
                                                <input type="number" value="1" class="input-qty yearly-qty" id="txtFirmQuantity" readonly style="width: 100%; padding: 8px; border: 1px solid #ced4da; border-radius: 4px; background-color: #e9ecef;">
                                            </td>
                                            <td style="padding: 8px 15px; border-bottom: 1px solid #e0e0e0;">
                                                <select class="form-select" id="txtFirmAmount" style="width:100%; padding: 8px; border: 1px solid #ced4da; border-radius: 4px;" onchange="toggleFirm();">
                                                    
                                                    <option value="1250">1250</option>
                                                    <option value="2500" selected>2500</option>
                                                </select>
                                            </td>
                                            @*<td style="padding: 8px 15px; border-bottom: 1px solid #e0e0e0;">
                                                <input type="text" class="input-amount yearly-amount" id="txtFirmAmount" readonly style="width: 100%; padding: 8px; border: 1px solid #ced4da; border-radius: 4px; background-color: #e9ecef;">
                                            </td>*@
                                            <td style="padding: 8px 15px; border-bottom: 1px solid #e0e0e0;">
                                                <input type="text" class="input-amount yearly-amount" id="txtFirmAmountVal" readonly style="width: 100%; padding: 8px; border: 1px solid #ced4da; border-radius: 4px; background-color: #e9ecef;">
                                            </td>
                                        </tr>

                                        <tr class="yearly-row" data-rate="2500" style="background-color: #ffffff;">
                                            <td style="padding: 12px 15px; border-bottom: 1px solid #e0e0e0;">
                                                <div style="display: flex; align-items: center; gap: 8px;">
                                                    <i class="fas fa-store" style="color: #6c757d;"></i>
                                                    <span style="color: #495057;">Additional Places of Business</span>
                                                </div>
                                            </td>
                                            <td style="padding: 8px 15px; border-bottom: 1px solid #e0e0e0;">
                                                <input type="number" class="input-qty yearly-qty" id="txtAdplQty" min="0" style="width: 100%; padding: 8px; border: 1px solid #ced4da; border-radius: 4px;" onchange="calculateAll()">
                                            </td>
                                            <td style="padding: 8px 15px; border-bottom: 1px solid #e0e0e0;">
                                                <input type="text" class="input-rate" id="txtAdplRate" readonly value="2500" style="width: 100%; padding: 8px; border: 1px solid #ced4da; border-radius: 4px; background-color: #e9ecef;">
                                            </td>
                                            <td style="padding: 8px 15px; border-bottom: 1px solid #e0e0e0;">
                                                <input type="text" class="input-amount yearly-amount" id="txtAdplAmt" readonly style="width: 100%; padding: 8px; border: 1px solid #ced4da; border-radius: 4px; background-color: #e9ecef;">
                                            </td>
                                        </tr>

                                        <tr class="yearly-row" data-rate="2500" style="background-color: #ffffff;">
                                            <td style="padding: 12px 15px; border-bottom: 1px solid #e0e0e0;">
                                                <div style="display: flex; align-items: center; gap: 8px;">
                                                    <i class="fas fa-users" style="color: #6c757d;"></i>
                                                    <span style="color: #495057;">Directors</span>
                                                </div>
                                            </td>
                                            <td style="padding: 8px 15px; border-bottom: 1px solid #e0e0e0;">
                                                <input type="number" class="input-qty yearly-qty" id="txtDirQty" min="0" style="width: 100%; padding: 8px; border: 1px solid #ced4da; border-radius: 4px;" onchange="calculateAll()">
                                            </td>
                                            <td style="padding: 8px 15px; border-bottom: 1px solid #e0e0e0;">
                                                <input type="text" class="input-rate" readonly value="2500" id="txtDirRate" style="width: 100%; padding: 8px; border: 1px solid #ced4da; border-radius: 4px; background-color: #e9ecef;">
                                            </td>
                                            <td style="padding: 8px 15px; border-bottom: 1px solid #e0e0e0;">
                                                <input type="text" class="input-amount yearly-amount" id="txtDirAmt" readonly style="width: 100%; padding: 8px; border: 1px solid #ced4da; border-radius: 4px; background-color: #e9ecef;">
                                            </td>
                                        </tr>

                                        <tr class="yearly-row" data-rate="1250" style="background-color: #ffffff;">
                                            <td style="padding: 12px 15px;">
                                                <div style="display: flex; align-items: center; gap: 8px;">
                                                    <i class="fas fa-users" style="color: #6c757d;"></i>
                                                    <span style="color: #495057;">Partners</span>
                                                </div>
                                            </td>
                                            <td style="padding: 8px 15px;">
                                                <input type="number" class="input-qty yearly-qty" id="txtPartQty" min="0" style="width: 100%; padding: 8px; border: 1px solid #ced4da; border-radius: 4px;" onchange="calculateAll()">
                                            </td>
                                            <td style="padding: 8px 15px;">
                                                <input type="text" class="input-rate" readonly value="1250" id="txtPartRate"  style="width: 100%; padding: 8px; border: 1px solid #ced4da; border-radius: 4px; background-color: #e9ecef;">
                                            </td>
                                            <td style="padding: 8px 15px;">
                                                <input type="text" class="input-amount yearly-amount" id="txtPartAmt" readonly style="width: 100%; padding: 8px; border: 1px solid #ced4da; border-radius: 4px; background-color: #e9ecef;">
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="totals-section" style="padding: 5px 25px 0px 20px; margin: -10px 20px 8px 20px;">
                                <div class="total-row">
                                    <span class="total-label">Total Yearly Amount</span>
                                    <span class="total-value" id="yearlyTotal">₹ 0</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="date-display">
                        <i class="fas fa-calendar-check"></i>
                        <div>
                            <strong>Current Date:</strong>
                            <span id="todayDate"></span>
                        </div>
                    </div>
                </div>
                <div class="actions-section">
                    <div class="button-group">
                        <button class="btn btn-reset" id="btnReset" onclick="resetForm()">
                            <i class="fas fa-redo"></i>
                            Reset Form
                        </button>
                        <button class="btn btn-primary" id="btnProceed" onclick="SubmitData();" disabled>
                            <i class="fas fa-file-alt"></i>
                            Submit & Pay
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <input type="hidden" id="hdnReturnId" />
        <input type="hidden" id="hdnDealerId" />
    </div>


    <script>
        var PTIN = '@Session["Tin"]';
        var UserId = '@Session["Userid"]';

        $(document).ready(function () {
            /*$('#tblYear :input').prop('disabled', true);*/
            if (UserId == "" || UserId == null || UserId == undefined) {
                $('#ptinInput').attr('disabled', false);
            }
            else {
                $('#ptinInput').attr('disabled', true);
            }
            if (PTIN != "" && PTIN != null && PTIN != undefined) {
                $('#ptinInput').val(PTIN);
                /*$('#ptinInput').attr('disabled', true);*/
                GetEnterpriseDeatils();
            }
        });
        function onPurposeChange(res) {
            if (res == "1") {
                $('#divReturnTax').show();
            }
            else {
                //$('#divReturnTax').hide();
                window.location.href = '@Url.Action("ePaymentGenMonthly", "ePayment")';
            }
        }

        function GetEnterpriseDeatils() {
            showloader();
            var PTIN = $('#ptinInput').val();
            $.ajax({
                url: '@Url.Action("GetPTEnterpriseDetails", "Return")',
                dataType: 'json',
                data: {
                    ptin: PTIN,
                },
                success: function (response) {
                    hideloader();
                    if (response.length > 0) {
                        var data = response[0];
                        $('#firmNameInput').val(data.EnterPriseName);
                        $('#hdnDealerId').val(data.DealerId);
                        getPtinDetails(PTIN);
                    }
                    else {
                        ModernAlert.toast.info('Please enter valid PTIN');
                        return false;
                    }
                },
                error: function (error) {
                    hideloader();
                    console.error(error);
                }
            });
        }
        function getPtinDetails(ptin) {
            $.ajax({
                url: '@Url.Action("GetReturnDetails", "ePayment")',
                dataType: 'json',
                data: {
                    ptin: ptin
                },
                success: function (response) {
                    GetPaymentPendingReturns(ptin,"Y");
                   /* if ((response[0].OwnerType == "Y" && response[0].Form1Reg == "N") || (response[0].OwnerType == "Y" && response[0].Form1Reg == "Y")) {
                        GetPaymentPendingReturns(ptin);
                    }
                    else {
                        ModernAlert.toast.info('You are not eligible');
                        return false;
                    }*/
                },
                error: function (error) {
                    console.error(error);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            const today = new Date();
            const formattedDate = today.toLocaleDateString('en-IN', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                weekday: 'long'
            });
            document.getElementById('todayDate').textContent = formattedDate;

            const fromDate = new Date();
            fromDate.setDate(1); // First day of current month
            const toDate = new Date();

            //document.getElementById('fromDate').valueAsDate = fromDate;
            //document.getElementById('toDate').valueAsDate = toDate;

            // Set max date for date inputs
            const dateInputs = document.querySelectorAll('.date-input');
            dateInputs.forEach(input => {
                input.max = toDate.toISOString().split('T')[0];
            });

            // Purpose selection toggle
            const returnRadio = document.getElementById("return_radio");
            const othRetRadio = document.getElementById("oth_ret_radio");
            const othRadio = document.getElementById("oth_radio");
            const othRetBox = document.getElementById("oth_ret_box");
            const othBox = document.getElementById("oth_box");

            function togglePurpose() {
                othRetBox.style.display = othRetRadio.checked ? "block" : "none";
                othBox.style.display = othRadio.checked ? "block" : "none";
            }

            document.querySelectorAll('input[name="purpose"]').forEach(radio => {
                radio.addEventListener("change", togglePurpose);
            });
            togglePurpose();

            // Initialize calculation
            //calculateAll();
        });

        // Date validation
        function validateDates() {
            const fromDate = new Date(document.getElementById('fromDate').value);
            const toDate = new Date(document.getElementById('toDate').value);

            if (fromDate > toDate) {
                alert('From date cannot be after To date. Please correct the dates.');
                document.getElementById('toDate').value = document.getElementById('fromDate').value;
            }
        }

        // Format currency
        function formatCurrency(amount) {
            return '₹ ' + amount.toLocaleString('en-IN');
        }

        // Calculation function
        var TotalAmount = "0";
        function calculateAll() {
            let yearlyTotal = 0;

            /*document.querySelectorAll('.yearly-row').forEach(row => {
                const qty = parseInt(row.querySelector('.yearly-qty').value) || 0;
                const rate = parseInt(row.dataset.rate) || 0;
                const amt = qty * rate;
                row.querySelector('.yearly-amount').value = amt;
            });*/


            let PlacesVal = 0; let DirectorsVal = 0; let PartnersVal = 0;
            const amt = $('#txtFirmAmount').val();
            $('#txtFirmAmountVal').val(amt);

            PlacesVal = (parseInt($('#txtAdplQty').val()) || 0) * (parseInt($('#txtAdplRate').val()) || 0);
            DirectorsVal = (parseInt($('#txtDirQty').val()) || 0) * (parseInt($('#txtDirRate').val()) || 0);
            PartnersVal = (parseInt($('#txtPartQty').val()) || 0) * (parseInt($('#txtPartRate').val()) || 0);

            $('#txtAdplAmt').val(PlacesVal);
            $('#txtDirAmt').val(DirectorsVal);
            $('#txtPartAmt').val(PartnersVal);

            let EntityTotal = 0; let PlacesTotal = 0; let DirectorsTotal = 0; let PartnersTotal = 0;
            EntityTotal = parseInt($('#txtFirmAmountVal').val()) || 0;
            PlacesTotal = parseInt($('#txtAdplAmt').val()) || 0;
            DirectorsTotal = parseInt($('#txtDirAmt').val()) || 0;
            PartnersTotal = parseInt($('#txtPartAmt').val()) || 0;
            yearlyTotal = EntityTotal + PlacesTotal + DirectorsTotal + PartnersTotal;
            document.getElementById('yearlyTotal').textContent = formatCurrency(yearlyTotal);

            const proceedBtn = document.getElementById('btnProceed');
            const totalAmount = yearlyTotal;
            TotalAmount = yearlyTotal;
            if (yearlyTotal > 0) {
                proceedBtn.disabled = false;
            }

        }


        // Toggle firm checkbox
        function toggleFirmOld(cb) {
            const qty = cb.closest('.yearly-row').querySelector('.yearly-qty');
            qty.value = cb.checked ? 1 : 0;
            const amt = cb.checked ? "2500" : "0";
            $('#txtFirmAmountVal').val(amt);
            calculateAll();
            if ($('#chkFirmCompany').is(':checked') == true) {
                $('#txtFirmQuantity').attr('disabled', true);
            }
            else {
                $('#txtFirmQuantity').attr('disabled', false);
            }
        }
        function toggleFirm() {
            const amt = $('#txtFirmAmount').val();
            $('#txtFirmAmountVal').val(amt);
            calculateAll();
        }

        function resetForm() {
            if (confirm('Are you sure you want to reset all form data?')) {
                location.reload();
            }
        }

        window.toggleFirm = toggleFirm;
        window.calculateAll = calculateAll;
        window.validateDates = validateDates;
        window.resetForm = resetForm;


        function BindYearsDropdown(response) {
            var $ddl = $('#ddlYear');
            $ddl.empty();
            $ddl.append($('<option>', {
                value: '0',
                text: '-- Select --'
            }));
            $.each(response, function (i, item) {
                if (item.mon_yr) {
                    $ddl.append($('<option>', {
                        value: item.mon_yr,
                        text: item.mon_yr + '-' + (parseFloat(item.mon_yr) + 1)
                    }));
                }
            });

        }

          function GetPaymentPendingReturns(ptin) {
            $.ajax({
                url: '@Url.Action("GetPaymentPendingReturns", "ePayment")',
                dataType: 'json',
                data: {
                    ptin: ptin,
                    OwnerType: "Y"
                },
                success: function (response) {
                    if (response.length > 0) {
                        PendingReturns = response;
                        BindYearsDropdown(response);
                    }
                    else {

                    }
                },
                error: function (error) {
                    console.error(error);
                }
            });
        }
         function GetPTTaxReturnMonthsNew(ptin, flag, dealertype) {
            $.ajax({
                url: '@Url.Action("GetPTTaxReturnDetails", "Return")',
                dataType: 'json',
                data: {
                    ptin: ptin,
                    flag: flag,
                    type: dealertype
                },
                success: function (response) {
                    if (response.length > 0) {
                        if (dealertype == "Y") {
                            BindYearsDropdown(response);
                        }
                        else {
                            BindMonthsDropdown(response);
                        }
                    }
                    else {

                    }
                },
                error: function (error) {
                    console.error(error);
                }
            });
        }
        function onFirmChange() {

            const ddl = document.getElementById("ddlFirmRate");
            const row = ddl.closest(".yearly-row");

            row.dataset.rate = ddl.value;

            var qty = $('#txtFirmQuantity').val();
            var rate = $('#ddlFirmRate').val();
            var value = parseInt(qty) * parseInt(rate);
            $('#txtFirmAmount').val(value);
            calculateAll();
        }

        function onYearChange() {
            var selectedYear = $('#ddlYear').val();
            var record = PendingReturns.find(x => x.mon_yr == selectedYear);
            var returnId = record ? record.ReturnId : null;
            if (returnId != null && returnId != undefined) {
                $('#hdnReturnId').val(returnId.trim());
                BuildTable();
            }
            else {
                $('#chkFirmCompany').attr('checked', false);
                $('#txtFirmQuantity').val("");
                $('#txtFirmAmountVal').val("");
                $('#txtAdplQty').val("");
                $('#txtAdplAmt').val("");
                $('#txtDirQty').val("");
                $('#txtDirAmt').val("");
                $('#txtPartQty').val("");
                $('#txtPartAmt').val("");
                calculateAll();
            }
        }
        function BuildTable() {
            var returnid = $('#hdnReturnId').val();
            var totalamount = "";
            $.ajax({
               url: '@Url.Action("GetReturnDetailsByReturnId", "ePayment")',
                dataType: 'json',
                data: {
                    ReturnId: returnid
                },
                success: function (data) {

                     totalamount = data[0].TotalAmount;

                    $.each(data, function (i, item) {
                        if (item.Type == "Entity") {
                            $('#txtFirmQuantity').val(item.Quantity);
                            $('#txtFirmAmount').val('2500');
                            $('#txtFirmAmountVal').val('2500');
                            $('#chkFirmCompany').attr('checked', true);
                        }
                        if (item.Type == "directors") {
                            $('#txtDirQty').val(item.Quantity);
                            $('#txtDirAmt').val(item.TaxAmount);
                        }
                        if (item.Type == "partners") {
                            $('#txtPartQty').val(item.Quantity);
                            $('#txtPartAmt').val(item.TaxAmount);
                        }
                        if (item.Type == "branch") {
                            $('#txtAdplQty').val(item.Quantity);
                            $('#txtAdplAmt').val(item.TaxAmount);
                        }
                    });

                    calculateAll();

                    /*$('#tblYear :input').prop('disabled', true);*/
                    $('#btnProceed').attr('disabled', false);

                },
                error: function () {
                    alert("Error loading data");
                }

            });

        }

        function SubmitData() {
            ModernAlert.showConfirm(
                'Are you sure you want to Submit and Pay?',
                'Confirm Submit',
                function (confirmed) {
                    if (confirmed) {
                        saveYearlyPayment();
                    }
                    else {
                        ModernAlert.toast.info('Action cancelled');
                    }
                }
            );
        }
        function saveYearlyPayment() {
            $('#btnProceed').attr('disabled', true);
            var _ptin = $('#ptinInput').val();
            if ($("#ddlYear").val() == "0" || $('#ddlYear').val() == "") {
                ModernAlert.toast.warning('Please Select Tax Period');
                return false;
            }
            if ($("#ddlEntity").val() == "0" || $('#ddlYear').val() == "") {
                ModernAlert.toast.warning('Please Select Entity');
                return false;
            }
            var model = {
                ReturnId: $('#hdnReturnId').val() || 0,
                Ptin: $('#ptinInput').val(),
                ReturnMonth: $("#ddlYear").val(),
                TotalPayable: TotalAmount,
                FiledBy: $('#ptinInput').val(),
                DealerId: $("#hdnDealerId").val(),
                FormType: "Y",

                SalSlabCode1: "1",
                NoEmp1: "1",
                TotPble1: $('#txtFirmAmountVal').val() || 0,
                Type1: "Entity",

                SalSlabCode2: "1",
                NoEmp2: $('#txtDirQty').val() || 0,
                TotPble2: $('#txtDirAmt').val() || 0,
                Type2: "directors",

                SalSlabCode3: "1",
                NoEmp3: $('#txtPartQty').val() || 0,
                TotPble3: $('#txtPartAmt').val() || 0,
                Type3: "partners",

                SalSlabCode4: "1",
                NoEmp4: $('#txtAdplQty').val() || 0,
                TotPble4: $('#txtAdplAmt').val() || 0,
                Type4: "branch"
            };


            $.ajax({
                url: '@Url.Action("SavePTYearlyPmt", "ePayment")',
                type: 'POST',
                data: JSON.stringify(model),
                contentType: 'application/json',
                success: function (res) {

                    if (res.success) {
                        var paymentUrl = '@Url.Action("PaymentConfirmation", "Payment")' + '?returnId=' + res.returnid + '&tin=' + _ptin;
                        ModernAlert.showAlert('Your Payment Details has been submitted Successfully!', 'You will be Redirecting to Payment Page', 'Submitted',
                            {
                                autoClose: true,
                                duration: 500,
                            }
                        );
                        setTimeout(() => {
                            window.location.href = paymentUrl;
                        }, 2000);
                        $('.modern-close').hide();

                    } else {
                        ModernAlert.showError('Unable to submit the Yearly Payment Details. Please try again.', 'Submit Failed');
                        $('#btnProceed').attr('disabled', false);
                    }
                },
                error: function () {
                    alert("Error while saving.");
                    $('#btnSave').attr('disabled', false);
                }
            });
        }
    </script>
</body>