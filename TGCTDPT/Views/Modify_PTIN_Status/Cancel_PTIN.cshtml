@using (Html.BeginForm("SubmitRequest", "Modify_PTIN_status", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="refund-container">
        <div class="form-card">

            <!-- Header -->
            <div class="form-header">
                <div class="form-header-text">
                    <h1>Request for Cancellation of PTIN</h1>
                    @*<p>Commercial Taxes Department</p>*@
                </div>
                @*<div class="form-badge">PTIN</div>*@
            </div>

            <div class="form-body">

                @* Hidden fields *@
                @Html.HiddenFor(m => m.prof_tin)
                @Html.HiddenFor(m => m.registration_status)
                @*@Html.HiddenFor(m => m.circle_code)*@

                <div class="form-grid-2 fields-grid">

                    <!-- PTIN -->
                    <div class="form-group field-group">
                        <label class="form-label">
                            <i class="fas fa-id-card"></i> PTIN:
                        </label>
                        @Html.TextBoxFor(m => m.prof_tin, new { @class = "form-input", @readonly = "readonly" })
                    </div>

                    <!-- Name -->
                    <div class="form-group field-group">
                        <label class="form-label">
                            <i class="fas fa-user"></i> Name:
                        </label>
                        @Html.TextBoxFor(m => m.enterprise_name, new { @class = "form-input", @readonly = "readonly" })
                    </div>

                    <!-- Division -->
                    <div class="form-group field-group">
                        <label class="form-label">
                            <i class="fas fa-building"></i> Division:
                        </label>
                        @Html.TextBoxFor(m => m.division_name, new { @class = "form-input", @readonly = "readonly" })
                    </div>

                    <!-- Circle -->
                    <div class="form-group field-group">
                        <label class="form-label">
                            <i class="fas fa-map-marker-alt"></i> Circle:
                        </label>
                        @Html.TextBoxFor(m => m.circle_name, new { @class = "form-input", @readonly = "readonly" })
                    </div>

                    <!-- Registration Date -->
                    <div class="form-group field-group">
                        <label class="form-label">
                            <i class="fas fa-calendar"></i> Date of Registration:
                        </label>
                        @Html.TextBoxFor(m => m.edr, new { @class = "form-input", @readonly = "readonly" })
                    </div>

                    <!-- Effective Date -->
                    <div class="form-group field-group">
                        <label class="form-label">
                            <i class="fas fa-calendar"></i> Effective Date of Cancellation:
                        </label>
                        @Html.TextBoxFor(m => m.effective_date, new
                        {
                            @type = "date",
                            @class = "form-input",
                            max = DateTime.Now.ToString("yyyy-MM-dd"),
                            required = "required"
                        })
                    </div>

                    <!-- File Upload -->
                    <div class="form-group field-group" style="grid-column: span 2;">
                        <label class="form-label">
                            <i class="fas fa-file-upload"></i>
                            Upload Document: <span class="text-danger">*</span>
                        </label>
                        <input type="file" name="file" class="form-input" accept="application/pdf" required />
                    </div>

                    <!-- Reason -->
                    <div class="form-group field-group" style="grid-column: span 2;">
                        <label class="form-label">
                            <i class="fas fa-comment"></i>
                            Reason for Cancellation:
                            <span class="text-danger">*</span>
                        </label>
                        @Html.TextAreaFor(m => m.reason, new
                        {
                            @class = "form-input",maxlength = "1000",placeholder = "Enter the reason for cancellation",
                            required = "required"
                        })
                    </div>

                </div>

                <!-- Submit -->
                <div class="actions-section submit-bar">
                    <div class="button-group">
                        <button type="submit" class="btn btn-submit">
                            <i class="fas fa-paper-plane"></i>
                            Submit
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
}




