@model List<TGCTDPT.Models.CircleReportModel>

@{
    ViewBag.Title = "CirLvlRetReport";
    Layout = "~/Views/Shared/_DeptLayout.cshtml";
}

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        .wrapper {
            max-width: 1200px;
            margin: auto;
            padding: 20px;
        }

        .card {
            background: white;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 6px 25px rgba(0,0,0,0.07);
        }

        .section-title {
            font-size: 22px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 20px;
        }

        .report-table {
            width: 100%;
            border-collapse: collapse;
        }

            .report-table th {
                background: #dbe2ea;
                border: 1px solid #cfd6dc;
                padding: 10px;
            }

            .report-table td {
                border: 1px solid #cfd6dc;
                padding: 8px;
                text-align: center;
            }

        .circle-link {
            font-weight: bold;
            color: #003366;
            text-decoration: none;
        }

            .circle-link:hover {
                color: #0b8b80;
            }
    </style>
</head>

<body>

    <div class="wrapper">

        <div class="card">

            <div class="section-title">
                Circle-wise Return Report - @ViewBag.Division
            </div>

            <table class="report-table">

                <thead>
                    <tr>
                        <th>Division</th>
                        <th>Circle</th>
                         
                        <th>Active TPs</th>
                        <th>Returns Filed</th>
                        <th>% Filed</th>
                        <th>No To Be Filed</th>
                        <th>% Pending</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.division_name</td>

                                <td>
                                    @Html.ActionLink(
                                        item.circle_name,
                                        "PTOReport",
                                        "Reports",
                                        new
                                        {
                                            division = item.division_name,
                                            circle = item.circle_name,
                                            year = ViewBag.Year
                                        },
                                        new { @class = "circle-link" }
                                    )
                                </td>

                                @*<td>@item.PTO_name</td>*@
                                <td>@item.ActiveTPs</td>
                                <td>@item.ReturnsFiled</td>
                                <td>@item.FiledPercentage %</td>
                                <td>@item.ToBeFiled</td>
                                <td>@item.PendingPercentage %</td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">No Records Found</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</body>













































