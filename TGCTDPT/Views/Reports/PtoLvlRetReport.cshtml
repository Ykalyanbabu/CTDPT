@model PagedList.IPagedList<TGCTDPT.Models.DealerReportModel>
@using PagedList.Mvc
@using System.Linq

@{
    ViewBag.Title = "PtoLvlRetReport";
    Layout = "~/Views/Shared/_DeptLayout.cshtml";
}

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        .wrapper {
            width: 100%;
            padding: 5px;
            margin: 0;
        }

        .card {
            width: 200%;
            min-height: 85vh;
            background: white;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 6px 25px rgba(0,0,0,0.07);
            overflow-y: auto;
        }

        .section-title {
            font-size: 26px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 25px;
        }

        .report-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .report-table th {
                background: #dbe2ea;
                border: 1px solid #cfd6dc;
                padding: 14px 10px;
                text-align: center;
                font-size: 15px;
                font-weight: 600;
            }

            .report-table td {
                border: 1px solid #cfd6dc;
                padding: 12px 8px;
                text-align: center;
                font-size: 14px;
                word-wrap: break-word;
            }

        .mail-btn {
            background: #0b8b80;
            color: white;
            border: none;
            padding: 8px 14px;
            border-radius: 6px;
            text-decoration: none;
            display: inline-block;
            font-size: 14px;
        }

            .mail-btn:hover {
                background: #0a7269;
                color: white;
            }

        .ptin-cell {
            font-weight: bold;
            color: #003366;
            text-decoration: none;
            font-size: 14px;
        }

            .ptin-cell:hover {
                color: #0b8b80;
            }

        .pagination-container {
            margin-top: 25px;
            text-align: center;
        }

        .pagination {
            display: inline-flex;
            list-style: none;
            padding: 0;
        }

            .pagination li {
                margin: 0 4px;
            }

                .pagination li a,
                .pagination li span {
                    padding: 8px 14px;
                    border: 1px solid #cfd6dc;
                    border-radius: 5px;
                    color: #003366;
                    text-decoration: none;
                }

            .pagination .active span {
                background: #0b8b80;
                color: white;
                border-color: #0b8b80;
            }
    </style>
</head>

<body>

    <div class="wrapper">

        <div class="card">

            <div class="section-title">
                Dealer-wise Return Report
            </div>

            <table class="report-table">

                <thead>
                    <tr>
                        <th>Division</th>
                        <th>Circle</th>
                        <th>PTO</th>
                        <th>PTIN</th>
                        <th>TP Name</th>
                        <th>Total To Be Filed</th>
                        <th>Filed</th>
                        <th>Not Filed</th>
                        <th>Mobile</th>
                        <th>Email</th>
                        <th>Send Mail</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                    <tr>

                        <td>@item.division_name</td>
                        <td>@item.circle_name</td>
                        <td>@item.PTO_name</td>
                        <td>@item.prof_tin</td>
                        @*<td>
                            @Html.ActionLink(
                                item.prof_tin,
                                "ReturnBreakupReport",
                                "Reports",
                                new
                                {
                                    ptin = item.prof_tin,
                                    year = ViewBag.Year
                                },
                                new { @class = "ptin-cell" }
                            )
                        </td>*@

                        <td>@item.enterprise_name</td>
                        <td>@item.TotReturns</td>
                        <td>@item.ReturnsFiled</td>
                        <td>@item.BalReturns</td>
                        <td>@item.mobile</td>
                        <td>@item.email_id</td>


                        <td>
                            @Html.ActionLink(
                                "Send_Mail",
                                "SendReminderMail",
                                "Reports",
                                new { ptin = item.prof_tin,
                                      enterprise_name = item.enterprise_name,
                                      filed = item.ReturnsFiled,
                                      to_befiled = item.BalReturns,
                                
                                },
                                new { @class = "mail-btn" }
                            )
                        </td>

                    </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11">No Records Found</td>
                        </tr>
                    }

                </tbody>

            </table>

            <div class="pagination-container">
                @Html.PagedListPager(
                    Model,
                    page => Url.Action("DealerReport", new
                    {
                        page,
                        year = ViewBag.Year,
                        division = ViewBag.Division,
                        circle = ViewBag.Circle,
                        pto = ViewBag.PTO
                    })
                )
            </div>

        </div>

    </div>

</body>

