@model List<TGCTDPT.Models.DivisionReportModel>

@{
    ViewBag.Title = "DivLvlRetReport";
    Layout = "~/Views/Shared/_DeptLayout.cshtml";
}

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary-color: #0b8b80;
            --primary-dark: #0a7269;
            --border-color: #e1e5e9;
        }

        .wrapper {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .card {
            background: white;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 6px 25px rgba(0,0,0,0.07);
            border: 1px solid rgba(255,255,255,0.8);
        }

        .section-title {
            font-size: 22px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 20px;
            color: #1e293b;
        }

        .year-box {
            text-align: right;
            margin-bottom: 15px;
        }

        select {
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 6px;
        }

        .report-table {
            width: 100%;
            border-collapse: collapse;
        }

            .report-table th {
                background: #dbe2ea;
                border: 1px solid #cfd6dc;
                padding: 10px;
                text-align: center;
            }

            .report-table td {
                border: 1px solid #cfd6dc;
                padding: 8px;
                text-align: center;
            }

            .report-table tbody tr:hover {
                background: #f1f7f7;
            }

        .division-link {
            font-weight: bold;
            color: #003366;
            text-decoration: none;
        }

            .division-link:hover {
                color: #0b8b80;
            }
    </style>
</head>

<body>

    <div class="wrapper">

        <div class="card">

            <div class="section-title">
                <i class="fas fa-chart-bar"></i>
                Division-wise Return Report
            </div>

            <div class="year-box">
                @using (Html.BeginForm("DivisionReport", "Reports", FormMethod.Get))
                {
                    <label>Select Year :</label>

                    <select name="year" onchange="this.form.submit()">
                        @for (int y = 2023; y <= DateTime.Now.Year ; y++)
                        {
                            <option value="@y" @(ViewBag.Year == y ? "selected" : "")>@y</option>
                        }
                    </select>
                }
            </div>

            <table class="report-table">

                <thead>
                    <tr>
                        <th>Division</th>
                        <th>Active TPs</th>
                        <th>No of Returns Filed</th>
                        <th>% Filed</th>
                        <th>No of Returns To Be Filed</th>
                        <th>% Pending</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @Html.ActionLink(
                                        item.division_name,
                                        "CircleReport",
                                        "Reports",
                                        new
                                        {
                                            division = item.division_name,
                                            year = ViewBag.Year
                                        },
                                        new { @class = "division-link" }
                                    )
                                </td>

                                <td>@item.ActiveTPs</td>
                                <td>@item.ReturnsFiled</td>
                                <td>@item.FiledPercentage %</td>
                                <td>@item.ToBeFiled</td>
                                <td>@item.PendingPercentage %</td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">No Records Found</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</body>



























