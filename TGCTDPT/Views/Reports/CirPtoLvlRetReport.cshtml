@model List<TGCTDPT.Models.PTOReportModel>
@using System.Linq

@{
    ViewBag.Title = "CirPtoLvlRetReport";
    Layout = "~/Views/Shared/_DeptLayout.cshtml";
}

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        .wrapper {
            max-width: 1200px;
            margin: auto;
            padding: 20px;
        }

        .card {
            background: white;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 6px 25px rgba(0,0,0,0.07);
        }

        .section-title {
            font-size: 22px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 20px;
        }

        .report-table {
            width: 100%;
            border-collapse: collapse;
        }

            .report-table th {
                background: #dbe2ea;
                border: 1px solid #cfd6dc;
                padding: 10px;
            }

            .report-table td {
                border: 1px solid #cfd6dc;
                padding: 8px;
                text-align: center;
            }

        .pto-link {
            font-weight: bold;
            color: #003366;
            text-decoration: none;
        }

            .pto-link:hover {
                color: #0b8b80;
            }
    </style>
</head>

<body>

    <div class="wrapper">

        <div class="card">

            <div class="section-title">
                PTO-wise Return Report
            </div>

            <table class="report-table">

                <thead>
                    <tr>
                        <th>Division</th>
                        <th>Circle</th>
                        <th>PTO Name</th>
                        <th>No Of Dealers</th>
                        <th>Returns Filed</th>
                        <th>Pending Returns</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.division_name</td>
                                <td>@item.circle_name</td>

                                <td>
                                    @Html.ActionLink(
                                         item.PTO_name,
                                         "DealerReport",
                                         "Reports",
                                         new
                                         {
                                             division = item.division_name,
                                             circle = item.circle_name,
                                             pto = item.PTO_name,
                                             year = ViewBag.Year
                                         },
                                         new { @class = "pto-link" }
                                     )
                                </td>

                                <td>@item.NoOfDealers</td>
                                <td>@item.ReturnsFiled</td>
                                <td>@item.PendingReturns</td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">No Records Found</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</body>



