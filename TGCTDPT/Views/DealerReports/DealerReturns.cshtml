@model TGCTDPT.Models.DealerReturnsModel

@{
    ViewBag.Title = "DealerReturns";
    Layout = "~/Views/Shared/_InnerLayout.cshtml";
}

<link href="~/assets/css/custom.css" rel="stylesheet" />

<body>

    <div class="container Reports">
        <div class="page-header">
            <h1 class="page-title"><i class="fas fa-chart-bar"></i> Returns Report</h1>
        </div>
        <div class="main-card">
            <div id="return">
                <div class="card-body">

                    @using (Html.BeginForm("DealerReturns", "DealerReports", FormMethod.Post))
                    {
                        <div class="form-grid">
                            <div class="form-group">
                                <label>PTIN</label>
                                <input type="text" class="form-control readonly" value="@Model.ptin" readonly>
                            </div>
                            <div class="form-group">
                                <label>Name of the Person / Business</label>
                                <input type="text" class="form-control readonly" value="@Model.enterprise_name" readonly>
                                @Html.HiddenFor(Model => Model.enterprise_name)
                            </div>
                            <div class="form-group">
                                <label>Select Financial Year</label>
                                <select class="form-control select" name="SelectedYear" onchange="this.form.submit()">
                                    <option value="2017" @(Model.f_year == "2017" ? "selected" : "")>2017-18</option>
                                    <option value="2018" @(Model.f_year == "2018" ? "selected" : "")>2018-19</option>
                                    <option value="2019" @(Model.f_year == "2019" ? "selected" : "")>2019-20</option>
                                    <option value="2020" @(Model.f_year == "2020" ? "selected" : "")>2020-21</option>
                                    <option value="2021" @(Model.f_year == "2021" ? "selected" : "")>2021-22</option>
                                    <option value="2022" @(Model.f_year == "2022" ? "selected" : "")>2022-23</option>
                                    <option value="2023" @(Model.f_year == "2023" ? "selected" : "")>2023-24</option>
                                    <option value="2024" @(Model.f_year == "2024" ? "selected" : "")>2024-25</option>
                                    <option value="2025" @(Model.f_year == "2025" ? "selected" : "")>2025-26</option>
                                    <option value="2026" @(Model.f_year == "2026" ? "selected" : "")>2026-27</option>
                                </select>
                            </div>
                        </div>
                    }
                    <!-- RETURN DETAILS -->
                    <div class="section">
                        <h3 class="section-title">
                            <i class="fas fa-file-alt"></i> RETURN DETAILS
                        </h3>
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Sl No</th>
                                    <th>Month</th>
                                    <th>Return ID</th>
                                    <th>Filing Date</th>
                                    <th>Status</th>
                                    <th>Amount Paid (₹)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.dlr_ret_dtls != null && Model.dlr_ret_dtls.Count > 0)
                                {

                                    foreach (var item in Model.dlr_ret_dtls)
                                    {
                                        <tr>
                                            <td>@item.SlNo</td>
                                            <td>@item.For_Month</td>
                                            <td>@item.ReturnID</td>
                                            <td>@(item.FilingDate?.ToString("dd/MM/yyyy"))</td>
                                            <td><span class="status-badge status-paid">@item.Status</span></td>
                                            <td class="amount-cell">@item.AmountPaid</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" style="text-align:center;">No returns found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="actions" style="display:none;">
                        <button class="btn btn-primary">
                            <i class="fas fa-print"></i> Print Report
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>