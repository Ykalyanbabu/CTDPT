@model TGCTDPT.Models.dlr_ret_dtls
@{
    ViewBag.Title = "ViewReturn";
    Layout = "~/Views/Shared/_InnerLayout.cshtml";
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <title>Payment Receipt | Tax Payment Voucher</title>
    <style>

        .main-content {
            max-width: 1200px !important;
            margin: 0 auto;
            padding: 150px 20px 40px;
            min-height: calc(106vh - 100px);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: auto;
            font-family: 'Segoe UI',sans-serif;
            background: #eef2f7;
        }

        body {
            padding: 10px;
        }

        .container {
            /*height: calc(100vh - 20px);*/

            display: flex;
            flex-direction: column;
        }

        .receipt-card {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: #fff;
            border-radius: 18px;
            overflow: auto;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .receipt-header {
            padding: 8px 12px;
            background: linear-gradient(90deg, #db26ca, #522369);
            color: #fff;
            text-align: center;
            flex-shrink: 0;
        }

            .receipt-header h1 {
                font-size: 17px;
                margin: 0;
            }

        .receipt-sub {
            margin-top: 1px;
            font-size: 10px;
        }

        .searchbar {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 6px;
            background: #fff;
            padding: 8px 10px;
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
            flex-shrink: 0;
        }

            .searchbar label {
                font-size: 12px;
                font-weight: 600;
                color: #163247;
                white-space: nowrap;
            }

            .searchbar input {
                height: 32px;
                font-size: 15px;
                font-family: 'Segoe UI',sans-serif;
            }

                .searchbar input:focus {
                    outline: none;
                    border-color: #234d69;
                }

        .btn {
            height: 32px;
            padding: 0 12px;
            border: none;
            border-radius: 7px;
            font-size: 11px;
            font-weight: 600;
        }

        .btn-primary {
            background: #163247;
            color: #fff;
        }

            .btn-primary:hover {
                background: #234d69;
            }

        .btn-outline {
            background: #fff;
            border: 1px solid #ccd6e0;
            color: #163247;
        }

        .receipt-content {
            flex: 1;
            padding: 6px 10px;
            display: flex;
            align-items: stretch;
        }

        .info-panel {
            width: 100%;
            height: 100%;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px 10px;
            align-content: start;
        }

        .info-row {
            display: flex;
            align-items: center;
            min-height: 32px;
            padding: 4px 8px;
            border: 1px solid #edf1f5;
            border-radius: 8px;
            background: #fafcff;
        }

        .info-label {
            width: 44%;
            font-size: 13px;
            font-weight: 700;
            color: #163247;
            display: flex;
            align-items: center;
            gap: 4px;
            line-height: 1.1;
        }

        .info-value {
            flex: 1;
            font-size: 13px;
            font-weight: 600;
            color: #222;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            line-height: 2;
        }

        .status-modern {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            border-radius: 30px;
            font-size: 13px;
            font-weight: 700;
        }

        .status-success {
            background: #dff6e8;
            color: #157347;
        }

        .status-pending {
            background: #fff4df;
            color: #b26a00;
        }

        .amount-strong {
            font-weight: 800;
            color: #157347;
            background: #e8f7ef;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
        }

        .challan-highlight {
            font-family: monospace;
            background: #eef3f8;
            padding: 3px 8px;
            border-radius: 20px;
        }

        .action-bar {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            padding: 6px 8px;
            border-top: 1px solid #e5ebf2;
            background: #fff;
            flex-shrink: 0;
        }

        .btn {
            height: 30px;
            min-width: 110px;
            padding: 0 14px;
            border: none;
            border-radius: 7px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: .2s;
            justify-content: center;
        }

        .btn-primary {
            background: #290ee1;
            color: #fff;
        }

        .btn-outline {
            background: #189392;
            border: 1px solid #ccd6e0;
            color: white;
        }

        .btn:hover {
            transform: translateY(-1px);
        }

        /* MOBILE */
        @@media(max-width:900px) {

            body {
                overflow: auto;
            }

            .container {
                height: auto;
            }

            .info-panel {
                grid-template-columns: 1fr;
            }

            .receipt-content {
                overflow: auto;
            }

            .info-row {
                min-height: 42px;
            }

            .info-value {
                white-space: normal;
            }
        }

        /* PRINT */
        @@media print {

            body {
                overflow: visible;
                background: #fff;
                padding: 0;
            }

            .searchbar,
            .action-bar, #mainMenu, .header-actions, #footer, .home-button, .button-container {
                display: none;
            }

            .container {
                height: auto;
            }

            .receipt-card {
                box-shadow: none;
                border-radius: 0;
            }

            .info-panel {
                grid-template-columns: 1fr 1fr;
            }
        }

        .button-container {
            padding: 0.7rem 1.2rem 0.9rem 1.2rem;
            text-align: center;
            background: #ffffff;
            border-top: 1px solid #ecf3fa;
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: center;
            flex-shrink: 0;
        }

        .home-button {
            background: linear-gradient(100deg, #1f2b48, #2c3e66);
            color: white;
            border: none;
            padding: 7px 22px;
            font-size: 0.8rem;
            font-weight: 600;
            border-radius: 60px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: inherit;
        }

            .home-button:hover {
                transform: translateY(-1px);
                background: linear-gradient(100deg, #2a3a60, #1f2e4e);
                box-shadow: 0 8px 16px rgba(0, 0, 0, 0.12);
            }

            .home-button:active {
                transform: translateY(1px);
            }

        .msg {
            font-size: 14px;
            padding: 6px 14px;
            border-radius: 6px;
            border-left: 3px solid;
            display: none;
            flex-shrink: 0;
        }

            .msg.info {
                background: #ffc965;
                border-color: var(--purple);
                color: black;
                text-align-last: center;
                font-weight: 600;
            }

            .msg.err {
                background: #fff0f0;
                border-color: #dc2626;
                color: #b91c1c
            }
    </style>
</head>
<body>
    @*<div class="searchbar">
            <label>&#128269; Department Transaction ID</label>
            <input id="txtTransactionId" type="text" style="width:25%;" placeholder="CTD Transaction Id" class="form-control" />
            <button class="btn btn-primary" onclick="doSearch()">Search</button>
            <button class="btn btn-outline" onclick="doClear()">Clear</button>
        </div>*@
    <div class="msg" id="msg"></div>
    <div class="container" id="divReceipt">
        <div class="receipt-card">
            <div class="receipt-header">
                <h1>
                    <span>📄</span> Profession Tax Return Filing Details
                </h1>
                @*<div class="receipt-sub">Transaction Information Summary | e-Challan Reference</div>*@
            </div>

            <div class="receipt-content">
                <div class="info-panel">

                    @*<div class="info-row">
                            <div class="info-label"><span class="icon-em"></span> Type of Tax</div>
                            <div class="info-value" id="taxtype-value">—</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label"><span class="icon-em"></span> Tax Purpose</div>
                            <div class="info-value" id="taxpurpose-value">—</div>
                        </div>*@

                    <div class="info-row">
                        <div class="info-label">PTIN</div>
                        <div class="info-value">@Model.ptin</div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">Name of Firm</div>
                        <div class="info-value">@Model.enterprise_name</div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">Return Id</div>
                        <div class="info-value">@Model.return_id</div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">CTD Transaction ID</div>
                        <div class="info-value">@Model.ctdtransaction_id</div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">Tax Period</div>
                        <div class="info-value">@Model.return_month</div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">No of Employees Below15000</div>
                        <div class="info-value">@Model._0_emp</div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">No of Employees Above15000</div>
                        <div class="info-value">@Model._150_emp</div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">No of Employees Above20000</div>
                        <div class="info-value">@Model._200_emp</div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">For Entity</div>
                        <div class="info-value">@Model.Entity</div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">No of Branches</div>
                        <div class="info-value">@Model.no_of_brnch</div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">No of Directors</div>
                        <div class="info-value">@Model.no_of_dir</div>
                    </div>

                    <div class="info-row">
                        <div class="info-label">No of Partners</div>
                        <div class="info-value">@Model.no_of_prtnr</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Amount</div>
                        <div class="info-value">@Model.total_payable</div>
                    </div>


                    <div class="info-row">
                        <div class="info-label">Status</div>
                        <div class="info-value">@Model.trans_status</div>
                    </div>
                </div>
            </div>

            <div class="button-container">
                <button class="home-button" onclick="printReceipt()">
                    Print
                </button>
            </div>
        </div>
    </div>


</body>


