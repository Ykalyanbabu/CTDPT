@model TGCTDPT.Models.RC_Details

@{
    ViewBag.Title = "profession_tax_certificate";
    Layout = null;

    string address = "";

    if (!string.IsNullOrEmpty(Model?.door_no))
    {
        address += Model.door_no;
    }

    if (!string.IsNullOrEmpty(Model?.city))
    {
        address += (address != "" ? ", " : "") + Model.city;
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profession Tax Certificate</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f0f0f0;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 30px 20px;
        }

        .print-btn {
            margin-top: 20px;
            padding: 10px 28px;
            background: #1a6e2a;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 15px;
            cursor: pointer;
        }

        .certificate {
            background: white;
            width: 680px;
            padding: 36px 48px 48px;
            border: 1px solid #ccc;
            box-shadow: 0 2px 16px rgba(0,0,0,0.12);
            position: relative;
            overflow: hidden;
        }

        /* WATERMARK */
        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            opacity: 0.05;
            z-index: 0;
            pointer-events: none;
        }

            .watermark img {
                width: 280px;
            }

        /* content above watermark */
        .header, .meta-row, table, .notice, .footer {
            position: relative;
            z-index: 1;
        }

        .header {
            text-align: center;
            margin-bottom: 18px;
        }

            .header h2 {
                font-size: 16px;
                font-weight: bold;
                line-height: 1.6;
            }

        .sub {
            font-size: 13px;
        }

        .form-title {
            font-size: 14px;
            font-weight: bold;
        }

        .cert-title {
            font-size: 17px;
            font-weight: bold;
        }

        .divider {
            border-top: 1px solid #333;
            margin: 14px 0;
        }

        .meta-row {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            margin-bottom: 10px;
        }

        .value {
            font-weight: bold;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        td {
            padding: 7px 4px;
            font-size: 13.5px;
            border-bottom: 1px solid #eee;
        }

        .field-label {
            width: 42%;
            font-weight: bold;
        }

        .colon {
            width: 4%;
            text-align: center;
        }

        .field-value {
            width: 54%;
        }

        .notice {
            margin-top: 18px;
            font-size: 12.5px;
            line-height: 1.6;
        }

        .footer {
            display: flex;
            justify-content: space-between;
            margin-top: 28px;
            font-size: 13px;
            font-weight: bold;
        }

        @@media print {
            body {
                background: white;
                padding: 0;
            }

            .print-btn {
                display: none;
            }

            .certificate {
                box-shadow: none;
                border: none;
            }

            .watermark {
                opacity: 0.08;
            }
        }
    </style>
</head>

<body>

    <!-- PRINT BUTTON -->

    <div class="certificate">

        <!-- WATERMARK -->
        <div class="watermark">
            <img src="@Url.Content("~/assets/images/logo.png")" />
        </div>

        <!-- HEADER -->
        <div class="header">
            <img src="@Url.Content("~/assets/images/logo.png")"
                 style="width:60px;height:60px;margin-bottom:5px;" />

            <h2>
                Government of Telangana<br>
                Commercial Taxes Department
            </h2>

            <div class="sub">(Section 6 Read with Rule 4)</div>
            <div class="form-title">FORM I & FORM II</div>
            <div class="cert-title">
                Profession Tax Payer Registration Certificate
            </div>
        </div>

        <hr class="divider" />

        <!-- META -->
        <div class="meta-row">
            <div>
                PTIN :
                <span class="value">
                    @(string.IsNullOrEmpty(Model?.prof_tin) ? "-" : Model.prof_tin)
                </span>
            </div>

            <div>
                Date & Time :
                <span class="value">
                    @DateTime.Now.ToString("dd-MMM-yyyy hh:mm tt")
                </span>
            </div>
        </div>

        <div class="meta-row">
            <div>
                Tax Division :
                @(string.IsNullOrEmpty(Model?.division_name) ? "-" : Model.division_name)
            </div>

            <div>
                Tax Circle :
                <span class="value">
                    @(string.IsNullOrEmpty(Model?.circle_name) ? "-" : Model.circle_name)
                </span>
            </div>
        </div>

        <hr class="divider" />

        <!-- DETAILS -->
        <table>

            <tr>
                <td class="field-label">Name</td>
                <td class="colon">:</td>
                <td class="field-value">
                    @(string.IsNullOrEmpty(Model?.enterprise_name) ? "-" : Model.enterprise_name)
                </td>
            </tr>

            <tr>
                <td class="field-label">Main Profession</td>
                <td class="colon">:</td>
                <td class="field-value">
                    @(string.IsNullOrEmpty(Model?.Profession_Type) ? "-" : Model.Profession_Type)
                </td>
            </tr>

            <tr>
                <td class="field-label">Address</td>
                <td class="colon">:</td>
                <td class="field-value">
                    @(string.IsNullOrEmpty(address) ? "-" : address)
                </td>
            </tr>

            <tr>
                <td class="field-label">Mandal</td>
                <td class="colon">:</td>
                <td class="field-value">
                    @(string.IsNullOrEmpty(Model?.mandal_code) ? "-" : Model.mandal_code)
                </td>
            </tr>

            <tr>
                <td class="field-label">District</td>
                <td class="colon">:</td>
                <td class="field-value">
                    @(string.IsNullOrEmpty(Model?.district_code) ? "-" : Model.district_code)
                </td>
            </tr>

            <tr>
                <td class="field-label">PIN</td>
                <td class="colon">:</td>
                <td class="field-value">
                    @(string.IsNullOrEmpty(Model?.pin) ? "-" : Model.pin)
                </td>
            </tr>

            <tr>
                <td class="field-label">Mobile</td>
                <td class="colon">:</td>
                <td class="field-value">
                    @(string.IsNullOrEmpty(Model?.mobile_number) ? "-" : Model.mobile_number)
                </td>
            </tr>

            <tr>
                <td class="field-label">Phone</td>
                <td class="colon">:</td>
                <td class="field-value">
                    @(string.IsNullOrEmpty(Model?.phone_number) ? "-" : Model.phone_number)
                </td>
            </tr>

            <tr>
                <td class="field-label">Email</td>
                <td class="colon">:</td>
                <td class="field-value">
                    @(string.IsNullOrEmpty(Model?.Email_Id) ? "-" : Model.Email_Id)
                </td>
            </tr>

        </table>

        <!-- NOTICE -->
        <div class="notice">
            The holder of this certificate shall abide by all the provisions of
            <b>Telangana Tax on Profession Trade, Calling and Employment Act, 1987</b>
            and the Rules framed there under.
        </div>

        <!-- FOOTER -->
        <div class="footer">
            <span>Date : @DateTime.Now.ToString("dd-MMM-yyyy")</span>
            <span>System Generated - No Signature Required</span>
        </div>

    </div>
    <button class="print-btn" onclick="window.print()">Print Certificate</button>

</body>
</html>