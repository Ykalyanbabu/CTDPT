        function validate_document() {


    var formData = new FormData();

    if (!documentList || documentList.length === 0) {
        alert("Please upload at least one document");
        return;
    }

    let i = 0;
    let isValid = true;

    documentList.forEach(function (item, index) {

        if (item != null) {

            if (!item.file) {
                alert("File missing at row " + (index + 1));
                isValid = false;
                return false;
            }

            //formData.append("model[" + i + "].application_id", appId);
            formData.append("model[" + i + "].master_doc_id", item.master_docid);
            formData.append("model[" + i + "].document_type", item.document_type);
            formData.append("files", item.file);

            i++;
        }
    });

    if (!isValid) return;

    if (i === 0) {
        alert("No valid documents to upload");
        return;
    }

    $.ajax({
        url: '@Url.Action("Save_documents", "Registration")',
        type: "POST",
        data: formData,
        processData: false,
        contentType: false,
        success: function (res) {
            if (res.success) {
                //alert("Documents uploaded successfully");
               ModernAlert.showSuccess('Your Refund has been Submitted successfully!', ' Submitted');
                ModernAlert.showSuccess(
                    'Your Application has been Submitted successfully with ARN No: ' + res.message,
                    'Success',
                    '@Url.Action("Home", "PTHome")'
                );
            } else {
                alert("Failed to upload documents");
                showTab("7");
            }
        },
        error: function () {
            alert("Error while uploading documents");
        }
    });
}

