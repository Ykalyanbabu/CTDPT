        function loaddistrict() {
            $.ajax({
                url: '@Url.Action("GetDistricts","Registration")',
                type: 'GET',
                success: function (data) {
                    var dropdown = $('#district');
                    var dropdown2 = $('#O_distict');
                    var dropdown3 = $('#auth_district');
                    var dropdown4 = $('#dir_prtnr_district');
                    var dropdown5 = $('#addl_plc_district');
                    dropdown.empty(); dropdown2.empty(); dropdown3.empty(); dropdown4.empty(); dropdown5.empty();

                    dropdown.append('<option value="">--Select--</option>');

                    $.each(data, function (i, item) {
                        dropdown.append('<option value="' + item.disrict_code + '">' + item.district_name + '</option>');
                    });
                    dropdown2.append('<option value="">--Select--</option>');

                    $.each(data, function (i, item) {
                        dropdown2.append('<option value="' + item.disrict_code + '">' + item.district_name + '</option>');
                    });
                    dropdown3.append('<option value="">--Select--</option>');

                    $.each(data, function (i, item) {
                        dropdown3.append('<option value="' + item.disrict_code + '">' + item.district_name + '</option>');
                    });
                    dropdown4.append('<option value="">--Select--</option>');

                    $.each(data, function (i, item) {
                        dropdown4.append('<option value="' + item.disrict_code + '">' + item.district_name + '</option>');
                    });
                    dropdown5.append('<option value="">--Select--</option>');

                    $.each(data, function (i, item) {
                        dropdown5.append('<option value="' + item.disrict_code + '">' + item.district_name + '</option>');
                    });

                },
                error: function () {
                    alert('Failed to load Districts');
                }
            });
        }


