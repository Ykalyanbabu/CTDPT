        let rnrCounter = 1;
        var documentList = [];


        $('#btnUploadDoc').on('click', function () {

            let docId = $('#doc_name').val();
            let docName = $('#doc_name option:selected').text();
           /* let docName = $('#doc_name ').val();*/
            let fileInput = $('#doc_file')[0];

            if (docId === "0") {
                alert("Please select document name");
                return;
            }

            if (fileInput.files.length === 0) {
                alert("Please select a PDF file");
                return;
            }

            let file = fileInput.files[0];

            if (file.type !== "application/pdf") {
                alert("Only PDF files are allowed");
                $('#doc_file').val('');
                return;
            }

            let obj = {
                master_docid:docId,
                document_type: docName,
                file: file
            };

            documentList.push(obj);

            $('#noDataRowFiles').remove();

            let fileURL = URL.createObjectURL(file);

            let row = `
        <tr data-index="${documentList.length - 1}">
            <td>${rnrCounter}</td>
            <td>${docName}</td>
            <td>${file.name}</td>
            <td class="text-center">
                <button class="btn btn-sm btn-primary viewFile" data-url="${fileURL}">
                    View
                </button>
                <button class="btn btn-sm btn-danger deleteFile">
                    Delete
                </button>
            </td>
        </tr>
    `;

            $('#DocumentsTable tbody').append(row);
            rnrCounter++;

            // reset
            $('#doc_name').val('0');
            $('#doc_file').val('');
        });
    $(document).on('click', '.viewFile', function () {
        let url = $(this).data('url');
        window.open(url, '_blank');
    });

    $(document).on('click', '.deleteFile', function () {
        if (!confirm("Do you want to delete this file?")) {
            return;
        }
        $(this).closest('tr').remove();

        if ($('#DocumentsTable tbody tr').length === 0) {
            $('#DocumentsTable tbody').append(`
                                                        <tr id="noDataRowFiles">
                                                            <td colspan="5" class="text-center text-muted">No Files added</td>
                                                        </tr>
                                                    `);
        }
    });

