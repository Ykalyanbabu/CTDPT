        function calculateTotalEmployees() {

            let below = parseInt($('#emp_below_15000').val()) || 0;
            let between = parseInt($('#emp_between_15001_20000').val()) || 0;
            let above = parseInt($('#emp_above_20000').val()) || 0;

            let total = below + between + above;

            $('#tot_emp').val(total);
        }

        // auto trigger when user types
        $('#emp_below_15000, #emp_between_15001_20000, #emp_above_20000')
            .on('input', function () {
                calculateTotalEmployees();
            });


