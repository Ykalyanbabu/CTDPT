    function fnSave() {
        Swal.fire({
            title: 'Success',
            // text: 'Submitted succesfully with ARN No.:XXXX on dd-MMM-yyyy to PTO for Approval.After Approval Your PTIN LoginID & Password will be sent to your Registered Email.',
            text: 'Registration Application submitted successfully with ARN:XXXXXX on dd-mm-yyyy to the PTO for Approval,The Registration summary sheet with ARN is shared to your registered email.After approval of the PT registration your PTIN,Login Id & Password will be sent to your registered Email.',

            icon: 'success',
            confirmButtonText: 'Ok'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = 'PT_Home.html';
            }
        });

        }



        function validate_Partners() {

            var container = document.querySelector("#divPartnerDirector");
            var inputs = container.querySelectorAll("input, select");
            var valid = true;

            inputs.forEach(function (input) {

                if (input.offsetParent !== null) {
                    if (input.id === "dir_prtnr_aadhaar" && input.value.trim() === "") {
                        input.style.border = "";
                        return;
                    }
                    if (input.value.trim() === "") {
                        input.style.border = "1px solid red";
                        valid = false;
                        return valid;
                    }
                    else {
                        input.style.border = "";
                    }
                }

            });
            if (!valid) {
                ModernAlert.toast.info('please fill all required fields correctly');
                return false;
            }

            if (!validate_dp_mobile()) valid = false;
            if (!validate_dp_pincode()) valid = false;
            if (!validate_dp_aadhaar()) valid = false;
            //if (!validate_Auth_email()) valid = false;
            if (!validate_dp_pan()) valid = false;

            if (!valid) {
                return false;
            }

        }
        let bankList = [];
        function Load_Banks() {
            $.ajax({
                url: '@Url.Action("GetBanks","Registration")',
                type: 'GET',
                success: function (data) {
                    bankList = data;
                    var dropdown = $('#bank_name');

                    dropdown.empty();

                    dropdown.append('<option value="">--Select--</option>');

                    $.each(data, function (i, item) {
                        dropdown.append('<option value="' + item.bank_id + '">' + item.bank_name + '</option>');
                    });
                },
                error: function () {
                    alert('Failed to Load Banks');
                }
            });
        }
        let selectedMin = 0;
        let selectedMax = 0;

        $("#bank_name").change(function () {
            let selectedBankId = $(this).val();
            let bank = bankList.find(x => x.bank_id == selectedBankId);
            if (bank) {
                selectedMin = bank.min_digits;
                selectedMax = bank.max_digits;
                if (selectedMax != 1) {
                    $("#account_number").attr("maxlength", selectedMax);
                }
                if (selectedMin == 1) {
                    $("#account_number").attr("placeholder",
                        `Enter account number`);
                }
                else {
                    if (selectedMin == selectedMax) {
                        $("#account_number").attr("placeholder",
                            `Enter ${selectedMin}  digit account number`);
                    }
                    else {
                        $("#account_number").attr("placeholder",
                            `Enter ${selectedMin}-${selectedMax} digit account number`);
                    }
                }
            }
            else {
                selectedMin = 0;
                selectedMax = 0;
            }
        });
            function checkAcNumber() {
                var acnolen = $("#account_number").val().length;
                if (acnolen > 0 && selectedMin != 1) {
                    if (acnolen < selectedMin || acnolen > selectedMax) {
                        ModernAlert.toast.info('Please enter valid Account Number');
                        $("#account_number").focus();
                        return false;
                    }
                }
            }
            function SubmitModifiedApp() {

                if (AppId == "" || AppId == null || AppId == undefined) {
                    ModernAlert.showError(res.message || "Failed to Submit");
                    return false;
                }
                else {
                    $.ajax({
                        url: '@Url.Action("ReSubmitApplication", "Registration")',
                        type: "POST",
                        data: { AppId: AppId },
                        success: function (res) {
                            if (res.success) {
                                ModernAlert.showSuccess(
                                    'Your Application has been Resubmitted successfully.',
                                    'Success',
                                    '@Url.Action("Home", "PTHome")'
                                );
                            }
                            else {
                                ModernAlert.showError(res.message || "Failed to Submit");
                            }
                        },
                        error: function () {
                            ModernAlert.showError(res.message || "Failed to Save");
                        }
                    });
                }
            }
        </script>
