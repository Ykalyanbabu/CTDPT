            var rnrno = '@Session["RNR"]';
            var AppStatus = '@Session["AppStatus"]';
            var QuerySts = '@Session["QuerySts"]';
            var AppId = '@Session["application_id"]';
            var getFullSummaryUrl = '@Url.Action("GetFullSummary", "Registration")';
            var getAppDtlsUrl = '@Url.Action("GetApplicationDtls", "Registration")';
            var landingUrl = '@Url.Action("SearchARN", "Home")';
            var isPartnerData = "";
            var isAddlPlaceData = "";
            var isBankData = "";
            var isDocData = "";

        $(document).ready(function () {

            var urlParams = new URLSearchParams(window.location.search);
            var type = urlParams.get('type');

            Load_Banks();
            if (AppId != null && AppId != undefined && AppId != "") {
                LoadApplicationDtls(AppId);
            }
            else {
                showTab('0');
                loadDivisions();
                loaddistrict();
            }

            if (QuerySts == "Y") {
                $('#btnSubmitSum').hide();
                $('#btnSubmitQuery').show();
            }

        });

        function loaddistrict(district,ddl) {
            $.ajax({
                url: '@Url.Action("GetDistricts","Registration")',
                type: 'GET',
                success: function (data) {
                    if (ddl == null || ddl == undefined || ddl == "") {
                        var dropdown = $('#district');
                        var dropdown2 = $('#O_distict');
                        var dropdown3 = $('#auth_district');
                        var dropdown4 = $('#dir_prtnr_district');
                        var dropdown5 = $('#addl_plc_district');
