        function validate_mobile() {

            var mob = document.getElementById("O_mobile_no");
            var value = mob.value.trim();

            if (!/^[0-9]{10}$/.test(value)) {
                mob.style.border = "1px solid red";
                alert("mobile number must be 10 digits");
                return false;
            }

