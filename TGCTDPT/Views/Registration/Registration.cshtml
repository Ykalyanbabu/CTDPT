        function validatePAN() {

    var pan = $('#business_pan').val().trim().toUpperCase();
    var panPattern = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/;

    $('#business_pan').val(pan);

    if (pan === "") {
        $('#panError').text("pan number is required");
        return false;
    }

    if (!panPattern.test(pan)) {
        $('#panError').text("invalid pan format (example: abcde1234f)");
        return false;
    }

    $('#panError').text("");


    $.ajax({
        url: '@Url.Action("CheckPantoPT", "Registration")',
        type: 'get',
        dataType: 'json',
        data: {
            pan: pan
        },
        success: function (response) {

            if (response && response.length > 0) {

                var _ptin = response[0].ptin;

                ModernAlert.showConfirm(
                    'you already have a ptin. do you want to proceed?',
                    'navigate',
                    function (confirmed) {
                        if (confirmed) {
                            window.location.href =
                                '@Url.Action("Login", "PTHome")?ptin=' + encodeURIComponent(_ptin);
                        }
                    }
                );
            }
            else {
                // optional: don't show error popup here (bad ux)
                console.log("pan not found, continue registration");
            }
        },
        error: function (error) {
            console.error(error);
        }
    });
}

        function validateBusiness() {

            var container = document.querySelector("#divBusiness");
            var inputs = container.querySelectorAll("input, select");
            var valid = true;

            inputs.forEach(function (input) {

                if (input.offsetParent !== null) {
                    if (input.value.trim() === "") {
                        input.style.border = "1px solid red";
                        valid = false;
                    } else {
                        input.style.border = "";
                    }
                }

            });
            if (!valid) {
                alert("Please fill all required fields.");
                return false;
            }

            var gonext = validate_pan();
            console.log(gonext);

            if (gonext === true) {
                var savedetails = fn_savedetails();

                if (savedetails) {

                    showTab("1");
                }
                else {
                    showTab("0");
                }

            }
            else {
                showTab("0");
            }

        }
        function fn_savedetails() {

            var data = {
                enterprise_name: $("#enterprise_name").val(),
                business_pan: $("#business_pan").val(),
                cobz: $("#cobz").val(),
                email_id: $("#email_id").val(),
                mobile_no: $("#mobile_no").val(),
                door_no: $("#door_no").val(),
                road_street: $("#road_street").val(),
                locality: $("#locality").val(),
                city: $("#city").val(),
                mandal: $("#mandal").val(),
                district: $("#district").val(),
                pincode: $("#pincode").val()

            };
            console.log()

            $.ajax({
                url: '@Url.Action("SaveBusinessDetails", "Registration")',
                type: 'POST',
                data: JSON.stringify(data),
                contentType: 'application/json; charset=utf-8',
                dataType: 'JSON',
                success: function (response) {

                    if (response.success) {

                        alert("Please Store this Application ID:" + response.data.application_id+" for Further Reference.");
                        showTab("1");

                    } else {

                        alert("Error while saving");
                        showTab("0");

                    }
                },
                error: function () {

                    alert("Server Error");

                }

            });

        }
        function validate_pan() {

            var regpan = document.getElementById("business_pan");
            var panPattern = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/;
            var panInput = regpan.value.trim().toUpperCase();
            console.log(panInput);
            if (!panPattern.test(panInput)) {
                regpan.style.border = "1px solid red";
                alert("Invalid PAN Format");
                return false;
            }

            regpan.style.border = "";
            return true;
        }

