@{ ViewBag.Title = "Refunds";
    Layout = "~/Views/Shared/_InnerLayout1.cshtml"; }
<link href="~/assets/css/Refunds.css" rel="stylesheet" />

<body>
    <div class="refund-container">
        <div class="form-card">

            <div class="form-header">
                <div class="form-header-text">
                    <h1>FORM XV — Claim for Refund</h1>
                    <p>(See Rule 29) &nbsp;|&nbsp; Commercial Taxes Department, Telangana</p>
                </div>
                <div class="form-badge">FORM XV</div>
            </div>

            <div class="form-body">

                <div class="user-info-bar">
                    <div class="user-field">
                        <label><i class="fas fa-id-card"></i> PTIN</label>
                        <div class="field-val" id="txtPtin"></div>
                    </div>
                    <div class="user-field">
                        <label><i class="fas fa-user"></i> Name of the Claimant</label>
                        <div class="field-val" id="txtName"></div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="section-head">
                        <h2><i class="fas fa-clipboard-check"></i> Assessment Details</h2>
                    </div>
                    <div class="section-inner">

                        <div class="radio-row">
                            <span>If refund is sought in pursuance of an order of assessment:</span>
                            <div class="radio-choices">
                                <label class="radio-opt">
                                    <input type="radio" name="assessment" value="yes" onchange="OnYesNo('Y')">
                                    <span class="r-circle"></span> Yes
                                </label>
                                <label class="radio-opt">
                                    <input type="radio" name="assessment" value="no" onchange="OnYesNo('N')">
                                    <span class="r-circle"></span> No
                                </label>
                            </div>
                        </div>

                        <div id="YesSection">
                            <div class="fields-grid">
                                <div class="field-group">
                                    <label>Order Number of Assessment <span class="req">*</span></label>
                                    <input type="text" placeholder="Enter order number" id="OrderNumber">
                                </div>
                                <div class="field-group">
                                    <label>Date of Order of Assessment <span class="req">*</span></label>
                                    <input type="date" id="OrderDate">
                                </div>
                                <div class="field-group">
                                    <label>Date of Notice of Final Assessment &amp; Refund Order <span class="req">*</span></label>
                                    <input type="date" id="DateofRevisedNotice">
                                </div>
                                <div class="field-group">
                                    <label>Date on which Notice was Served on the Dealer <span class="req">*</span></label>
                                    <input type="date" id="servedDate">
                                </div>
                                <div class="field-group">
                                    <label>Refund Amount Claimed (₹) <span class="req">*</span></label>
                                    <input type="text" onkeypress="return isNumber(event)" placeholder="Enter claimed amount" id="ClmdAmnt">
                                </div>
                            </div>
                        </div>

                        <div id="divNoSection" style="margin-top:14px;">
                            <p style="font-size: 13px; color: #000000; font-weight: 600;">
                                Refund is sought in pursuance of an order passed in appeal or revision.
                            </p>
                        </div>

                        <div id="NoSection">
                            <div class="fields-grid">
                                <div class="field-group">
                                    <label>Order Number (Appellate / Revisional Authority) <span class="req">*</span></label>
                                    <input type="text" placeholder="Enter order number" id="NoOrderNumber">
                                </div>
                                <div class="field-group">
                                    <label>Date of Order (Appellate / Revisional Authority) <span class="req">*</span></label>
                                    <input type="date" id="NoOrderDate">
                                </div>
                                <div class="field-group">
                                    <label>Date of Revised Notice of Final Assessment &amp; Refund Order <span class="req">*</span></label>
                                    <input type="date" id="NoDateofRevisedNotice">
                                </div>
                                <div class="field-group">
                                    <label>Date on which Notice was Served on the Dealer <span class="req">*</span></label>
                                    <input type="date" id="NoServedDate">
                                </div>
                                <div class="field-group">
                                    <label>Amount of Refund Due (₹) <span class="req">*</span></label>
                                    <input type="text" onkeypress="return isNumber(event)" placeholder="Enter refund amount" id="NoClmdAmnt">
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="form-section" id="YesSectionFiles">
                    <div class="section-head">
                        <h2><i class="fas fa-cloud-upload-alt"></i> Upload Documents</h2>
                    </div>
                    <div class="section-inner">
                        <div class="upload-rows-list">

                            <!-- Row 1 -->
                            <div class="upload-row-item" id="uploadCardY1">
                                <input type="file" accept=".pdf,.jpg,.jpeg,.png" onchange="handleUpload(this,1)">
                                <div class="urow-icon"><i class="fas fa-file-alt"></i></div>
                                <div class="urow-meta">
                                    <div class="urow-title">Order of Assessment <span class="req">*</span></div>
                                    <div class="urow-hint">PDF, JPG or PNG · Max 10 MB</div>
                                    <div class="urow-filename" id="fileName1"></div>
                                </div>
                                <div class="urow-actions">
                                    <button type="button" class="urow-btn-preview" id="previewBtn1" onclick="openLightbox(1)" title="Preview"><i class="fas fa-eye"></i></button>
                                    <button type="button" class="urow-btn-remove" id="removeBtn1" onclick="removeFile(1)" title="Remove"><i class="fas fa-trash-alt"></i></button>
                                    <button type="button" class="urow-btn-choose" id="uploadCardBtn1"><i class="fas fa-upload"></i> Choose File</button>
                                </div>
                            </div>

                            <div class="upload-row-item" id="uploadCardY2">
                                <input type="file" accept=".pdf,.jpg,.jpeg,.png" onchange="handleUpload(this,2)">
                                <div class="urow-icon"><i class="fas fa-file-invoice"></i></div>
                                <div class="urow-meta">
                                    <div class="urow-title">Final Assessment &amp; Refund Order Served <span class="req">*</span></div>
                                    <div class="urow-hint">PDF, JPG or PNG · Max 10 MB</div>
                                    <div class="urow-filename" id="fileName2"></div>
                                </div>
                                <div class="urow-actions">
                                    <button type="button" class="urow-btn-preview" id="previewBtn2" onclick="openLightbox(2)" title="Preview"><i class="fas fa-eye"></i></button>
                                    <button type="button" class="urow-btn-remove" id="removeBtn2" onclick="removeFile(2)" title="Remove"><i class="fas fa-trash-alt"></i></button>
                                    <button type="button" class="urow-btn-choose" id="uploadCardBtn2"><i class="fas fa-upload"></i> Choose File</button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="form-section" id="NoSectionFiles">
                    <div class="section-head">
                        <h2><i class="fas fa-cloud-upload-alt"></i> Upload Documents</h2>
                    </div>
                    <div class="section-inner">
                        <div class="upload-rows-list">

                            <!-- Row 1 -->
                            <div class="upload-row-item" id="uploadCard3">
                                <input type="file" accept=".pdf,.jpg,.jpeg,.png" onchange="handleUpload(this,3)">
                                <div class="urow-icon"><i class="fas fa-file-alt"></i></div>
                                <div class="urow-meta">
                                    <div class="urow-title">Order of the Appellate or Revisional Authority <span class="req">*</span></div>
                                    <div class="urow-hint">PDF, JPG or PNG · Max 10 MB</div>
                                    <div class="urow-filename" id="fileName3"></div>
                                </div>
                                <div class="urow-actions">
                                    <button type="button" class="urow-btn-preview" id="previewBtn1" onclick="openLightbox(3)" title="Preview"><i class="fas fa-eye"></i></button>
                                    <button type="button" class="urow-btn-remove" id="removeBtn1" onclick="removeFile(3)" title="Remove"><i class="fas fa-trash-alt"></i></button>
                                    <button type="button" class="urow-btn-choose" id="uploadCardBtn3"><i class="fas fa-upload"></i> Choose File</button>
                                </div>
                            </div>

                            <div class="upload-row-item" id="uploadCard4">
                                <input type="file" accept=".pdf,.jpg,.jpeg,.png" onchange="handleUpload(this,4)">
                                <div class="urow-icon"><i class="fas fa-file-invoice"></i></div>
                                <div class="urow-meta">
                                    <div class="urow-title">Notice of Final Assessment <span class="req">*</span></div>
                                    <div class="urow-hint">PDF, JPG or PNG · Max 10 MB</div>
                                    <div class="urow-filename" id="fileName3"></div>
                                </div>
                                <div class="urow-actions">
                                    <button type="button" class="urow-btn-preview" id="previewBtn4" onclick="openLightbox(4)" title="Preview"><i class="fas fa-eye"></i></button>
                                    <button type="button" class="urow-btn-remove" id="removeBtn4" onclick="removeFile(4)" title="Remove"><i class="fas fa-trash-alt"></i></button>
                                    <button type="button" class="urow-btn-choose" id="uploadCardBtn4"><i class="fas fa-upload"></i> Choose File</button>
                                </div>
                            </div>

                            <div class="upload-row-item" id="uploadCard5">
                                <input type="file" accept=".pdf,.jpg,.jpeg,.png" onchange="handleUpload(this,5)">
                                <div class="urow-icon"><i class="fas fa-file-contract"></i></div>
                                <div class="urow-meta">
                                    <div class="urow-title">Notice of Final Order <span class="req">*</span></div>
                                    <div class="urow-hint">PDF, JPG or PNG · Max 10 MB</div>
                                    <div class="urow-filename" id="fileName5"></div>
                                </div>
                                <div class="urow-actions">
                                    <button type="button" class="urow-btn-preview" id="previewBtn5" onclick="openLightbox(5)" title="Preview"><i class="fas fa-eye"></i></button>
                                    <button type="button" class="urow-btn-remove" id="removeBtn5" onclick="removeFile(5)" title="Remove"><i class="fas fa-trash-alt"></i></button>
                                    <button type="button" class="urow-btn-choose" id="uploadCardBtn5"><i class="fas fa-upload"></i> Choose File</button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="lightbox-overlay" id="lightboxOverlay" onclick="closeLightboxOutside(event)">
                    <div class="lightbox-box">
                        <div class="lightbox-header">
                            <span id="lightboxTitle"><i class="fas fa-file"></i> Document Preview</span>
                            <button class="lightbox-close" onclick="closeLightbox()"><i class="fas fa-times"></i></button>
                        </div>
                        <div class="lightbox-body" id="lightboxBody"></div>
                        <div class="lightbox-footer">
                            <span id="lightboxMeta"></span>
                            <button class="btn-paction view" onclick="closeLightbox()"><i class="fas fa-times"></i> Close</button>
                        </div>
                    </div>
                </div>

                <div class="submit-bar">
                    <button class="submit-button" id="btnSave" onclick="SubmitRefundForm()">
                        <span class="transition"></span>
                        <span class="gradient"></span>
                        <span class="label">Submit</span>
                    </button>
                </div>

            </div>
        </div>
    </div>

    <script>
        var PTIN = '@Session["Tin"]';
        $(document).ready(function () {
            GetEnterpriseDeatils(PTIN);
        });

        function GetEnterpriseDeatils(PTIN) {
            $.ajax({
                url: '@Url.Action("GetPTEnterpriseDetails", "Return")',
                dataType: 'json',
                data: {
                    ptin: PTIN,
                },
                success: function (response) {
                    if (response.length > 0) {
                        var data = response[0];
                        $('#txtPtin').text(data.PTIN);
                        $('#txtName').text(data.EnterPriseName);
                    }
                    else {

                    }
                },
                error: function (error) {
                    hideloader();
                    console.error(error);
                }
            });
        }

        const uploadedFiles = {};

        function formatSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
        }

        function handleUpload(input, idx) {
            const file = input.files[0];
            if (!file) return;

            const card = document.getElementById('uploadCardY' + idx);
            const nameEl = document.getElementById('fileName' + idx);
            const btn = document.getElementById('uploadCardBtn' + idx);

            const url = URL.createObjectURL(file);
            uploadedFiles[idx] = { file, url };

            card.classList.add('has-file');
            nameEl.textContent = file.name + '  (' + formatSize(file.size) + ')';
            btn.innerHTML = '<i class="fas fa-check"></i> Uploaded';
        }

        function removeFile(idx) {
            const card = document.getElementById('uploadCardY' + idx);
            const nameEl = document.getElementById('fileName' + idx);
            const btn = document.getElementById('uploadCardBtn' + idx);
            const input = card.querySelector('input[type="file"]');

            card.classList.remove('has-file');
            nameEl.textContent = '';
            btn.innerHTML = '<i class="fas fa-upload"></i> Choose File';
            input.value = '';
            if (uploadedFiles[idx]) {
                URL.revokeObjectURL(uploadedFiles[idx].url);
                delete uploadedFiles[idx];
            }
        }

        function openLightbox(idx) {
            const data = uploadedFiles[idx];
            if (!data) return;
            const { file, url } = data;

            const overlay = document.getElementById('lightboxOverlay');
            const body = document.getElementById('lightboxBody');
            const title = document.getElementById('lightboxTitle');
            const meta = document.getElementById('lightboxMeta');

            body.innerHTML = '';
            title.innerHTML = `<i class="fas fa-${file.type.startsWith('image/') ? 'image' : 'file-pdf'}"></i> ${file.name}`;
            meta.textContent = formatSize(file.size) + '  ·  ' + (file.type.startsWith('image/') ? 'Image' : 'PDF');

            if (file.type.startsWith('image/')) {
                const img = document.createElement('img');
                img.src = url;
                body.appendChild(img);
            } else {
                const frame = document.createElement('iframe');
                frame.src = url;
                body.appendChild(frame);
            }

            overlay.classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            document.getElementById('lightboxOverlay').classList.remove('open');
            document.body.style.overflow = '';
            document.getElementById('lightboxBody').innerHTML = '';
        }

        function closeLightboxOutside(e) {
            if (e.target === document.getElementById('lightboxOverlay')) closeLightbox();
        }

        function OnYesNo(res) {
            if (res === "Y") {
                document.getElementById('YesSection').style.display = 'block';
                document.getElementById('NoSection').style.display = 'none';
                document.getElementById('divNoSection').style.display = 'none';
                /*document.getElementById('YesSectionFiles').style.display = 'block';
                  document.getElementById('NoSectionFiles').style.display = 'none';*/
            } else {
                document.getElementById('YesSection').style.display = 'none';
                document.getElementById('NoSection').style.display = 'block';
                document.getElementById('divNoSection').style.display = 'block';
                /*document.getElementById('YesSectionFiles').style.display = 'none';
                document.getElementById('NoSectionFiles').style.display = 'block';*/
            }
            getDocuments();
        }


        function getDocuments() {
            var rdbValue = $("input[name='assessment']:checked").val();
            var _type = rdbValue.toLowerCase() === "yes" ? "OA" : "OAR";

            $.ajax({
                url: '@Url.Action("GetDocumetsCheckList", "Refunds")',
                dataType: 'json',
                data: {
                    Type: _type
                },
                success: function (response) {
                    bindDocuments(response);
                },
                error: function (error) {
                    console.error(error);
                }
            });

        }
        function bindDocuments(data) {

            var html = "";

            $.each(data, function (i, item) {
                var icon = "fas fa-file-invoice";
                html += `
                <div class="upload-row-item" id="uploadCardY${item.id}">
                    <input type="file" accept=".pdf,.jpg,.jpeg,.png" onchange="handleUpload(this,${item.id})">

                    <div class="urow-icon">
                        <i class="${icon}"></i>
                    </div>

                    <div class="urow-meta">
                        <div class="urow-title">
                            ${item.doc_name}
                            ${item.required ? '<span class="req">*</span>' : ''}
                        </div>

                        <div class="urow-hint">
                            PDF, JPG or PNG · Max 10 MB
                        </div>

                        <div class="urow-filename" id="fileName${item.id}"></div>
                    </div>

                    <div class="urow-actions">
                        <button type="button"
                            class="urow-btn-preview"
                            id="previewBtn${item.id}"
                            onclick="openLightbox(${item.id})"
                            title="Preview">
                            <i class="fas fa-eye"></i>
                        </button>

                        <button type="button"
                            class="urow-btn-remove"
                            id="removeBtn${item.id}"
                            onclick="removeFile(${item.id})"
                            title="Remove">
                            <i class="fas fa-trash-alt"></i>
                        </button>

                        <button type="button"
                            class="urow-btn-choose"
                            id="uploadCardBtn${item.id}">
                            <i class="fas fa-upload"></i> Choose File
                        </button>
                    </div>
                </div>
                `;
            });

            $(".upload-rows-list").html(html);
            $('#YesSectionFiles').show();

        }

        function SubmitRefundForm() {


            var ptin = $('#txtPtin').text();
            var enterprisename = $('#txtName').text();
            var rdbValue = $("input[name='assessment']:checked").val();

            if (rdbValue == "" || rdbValue == undefined || rdbValue ==null) {
                ModernAlert.toast.warning('Please select If refund is sought in pursuance of an order of assessment (Yes/No)');
                return false;
            }
            var orderassessment = rdbValue.toLowerCase() === "yes" ? "OA" : "OAR";
            var dateorderassessmnt = orderassessment === "OA" ? $('#OrderDate').val() : $('#NoOrderDate').val();
            var numberorderassessmnt = orderassessment === "OA" ? $('#OrderNumber').val() : $('#NoOrderNumber').val();
            var datenoticefinalassessmnt = orderassessment === "OA" ? $('#DateofRevisedNotice').val() : $('#NoDateofRevisedNotice').val();
            var datenoticefinalassessmntserved = orderassessment === "OA" ? $('#servedDate').val() : $('#NoServedDate').val();
            var refundamountordered = orderassessment === "OA" ? $('#ClmdAmnt').val() : $('#NoClmdAmnt').val();
            var FileCount = orderassessment === "OA" ? "2" : "3";

            if (ptin == "") {
                ModernAlert.toast.warning('You cannot save the Data without PTIN');
                return false;
            }
            if (enterprisename == "") {
                ModernAlert.toast.warning('You cannot save the Data without Enterprise Name');
                return false;
            }
            if (rdbValue == "") {
                ModernAlert.toast.warning('Please select If refund is sought in pursuance of an order of assessment (Yes/No)');
                return false;
            }
            if (numberorderassessmnt == "") {
                ModernAlert.toast.warning('Please enter Order Number of Assessment/(Appellate / Revisional Authority)');
                return false;
            }
            if (dateorderassessmnt == "") {
                ModernAlert.toast.warning('Please select Date of Order of Assessment/(Appellate / Revisional Authority)');
                return false;
            }
            if (datenoticefinalassessmnt == "") {
                ModernAlert.toast.warning('Please select Date of Date of Notice of Final Assessment & Refund Order/Revised Notice of Final Assessment & Refund Order');
                return false;
            }
            if (datenoticefinalassessmntserved == "") {
                ModernAlert.toast.warning('Please select Date on which Notice was Served on the Dealer');
                return false;
            }
            if (refundamountordered == "") {
                ModernAlert.toast.warning('Please enter Refund Amount Claimed/Amount of Refund Due');
                return false;
            }
            if (Object.keys(uploadedFiles).length != parseInt(FileCount)) {
                ModernAlert.toast.warning('Please upload all necessary documents in Upload Documents Section');
                return false;
            }


            ModernAlert.showConfirm(
                'Are you sure you want to Submit Refunds Data? This action cannot be undone.',
                'Confirm Submit',
                function (confirmed) {
                    if (confirmed) {
                        SaveData();
                    }
                    else {
                        ModernAlert.toast.info('Action cancelled');
                    }
                }
            );
        }


        function SaveData() {
            $('#submitBtn').attr('disabled', true);
            var formData = new FormData();
            var ptin = $('#txtPtin').text();
            var enterprisename = $('#txtName').text();
            var rdbValue = $("input[name='assessment']:checked").val();
            var orderassessment = rdbValue.toLowerCase() === "yes" ? "OA" : "OAR";
            var dateorderassessmnt = orderassessment === "OA" ? $('#OrderDate').val() : $('#NoOrderDate').val();
            var numberorderassessmnt = orderassessment === "OA" ? $('#OrderNumber').val() : $('#NoOrderNumber').val();
            var datenoticefinalassessmnt = orderassessment === "OA" ? $('#DateofRevisedNotice').val() : $('#NoDateofRevisedNotice').val();
            var datenoticefinalassessmntserved = orderassessment === "OA" ? $('#servedDate').val() : $('#NoServedDate').val();
            var refundamountordered = orderassessment === "OA" ? $('#ClmdAmnt').val() : $('#NoClmdAmnt').val();


            formData.append("prof_tin", ptin);
            formData.append("enterprise_name", enterprisename);
            formData.append("order_assessment", orderassessment);
            formData.append("date_order_assessmnt", dateorderassessmnt);
            formData.append("number_order_assessmnt", numberorderassessmnt);
            formData.append("date_notice_final_assessmnt", datenoticefinalassessmnt);
            formData.append("date_notice_final_assessmnt_served", datenoticefinalassessmntserved);
            formData.append("refund_amount_ordered", refundamountordered);
            formData.append("created_by", ptin);

            for (const key in uploadedFiles) {
                formData.append("files", uploadedFiles[key].file);
                formData.append("docIds", key);
            }

            $.ajax({
                url: '@Url.Action("SubmitRefund", "Refunds")',
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                success: function (res) {

                    if (res.success) {
                        ModernAlert.showSuccess('Your Refund has been Submitted successfully!', 'Refund Submitted');
                         ModernAlert.showSuccess(
                         'Your Refund has been Submitted successfully',
                         'Success',
                         '@Url.Action("Refunds", "Refunds")'
                         );
                    }
                    else {
                        $('#submitBtn').attr('disabled', false);
                        ModernAlert.showError(res.message, 'Failed to Submit');
                    }
                },
                error: function () {
                    $('#submitBtn').attr('disabled', false);
                    ModernAlert.showError("Submission failed Please try after sometime", 'Failed to Submit');
                }
            });
        }


    </script>
</body>
