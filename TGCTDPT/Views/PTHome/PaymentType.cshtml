
@{
    ViewBag.Title = "Payment Type";
    Layout = ViewBag.Layout;
}

@if (Session["Userid"] != null)
{
    <style>
        .reports-wrapper {
            max-width: 1200px;
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.1);
            margin: 15px auto 30px auto;
            overflow: hidden;
        }
    </style>
}
else
{
    <style>
        .reports-wrapper {
            max-width: 1200px;
            background: #ffffff;
            border-radius: 24px;
            box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.08);
            margin: 15px auto 30px auto;
            overflow: hidden;
        }
    </style>
}
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
        background: #f5f7fb;
        font-family: 'Inter', sans-serif;
    }

    .reports-wrapper {
        max-width: 1000px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,.08);
        overflow: hidden;
    }


    .report-card {
        background: #fff;
    }

    .report-header {
        text-align: center;
        padding: 18px 20px;
        border-bottom: 1px solid #edf2f7;
        background: #9b5fa0;
    }

    .header-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        margin: 0 auto 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg,#8b5cf6,#7c3aed);
    }

        .header-icon i {
            color: #fff;
            font-size: 18px;
        }

    .report-header h2 {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 2px;
        color: white;
    }

    .report-header p {
        font-size: 13px;
        color: #6b7280;
        margin: 0;
    }



    .reports-grid {
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .report-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border: 1px solid #edf2f7;
        border-radius: 12px;
        text-decoration: none;
        background: #fff;
        transition: all .2s ease;
    }

        .report-item:hover {
            background: #fafbff;
            border-color: #d8dff0;
            transform: translateX(3px);
            box-shadow: 0 2px 8px rgba(0,0,0,.04);
        }



    .report-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .report-icon i {
            color: #fff;
            font-size: 16px;
        }



    .report-info {
        flex: 1;
    }

        .report-info h3 {
            font-size: 14px;
            font-weight: 600;
            color: #1f2937;
            margin-bottom: 2px;
        }

        .report-info p {
            font-size: 12px;
            color: #6b7280;
            margin-bottom: 4px;
        }



    .report-badge {
        display: inline-block;
        padding: 2px 8px;
        font-size: 10px;
        font-weight: 500;
        border-radius: 20px;
        background: #f3f4f6;
        color: #4b5563;
    }

        .report-badge.coming {
            background: #fef3c7;
            color: #b45309;
        }



    .report-arrow {
        color: #9ca3af;
        font-size: 13px;
        transition: .2s;
    }

    .report-item:hover .report-arrow {
        color: #8b5cf6;
        transform: translateX(2px);
    }



    .report-item.disabled {
        opacity: .65;
        cursor: default;
    }

        .report-item.disabled:hover {
            transform: none;
            background: #fff;
            box-shadow: none;
        }



    @@media(max-width:768px) {

        .reports-wrapper {
            margin: 10px;
            border-radius: 12px;
        }

        .report-header {
            padding: 15px;
        }

        .report-item {
            padding: 10px;
        }

        .report-icon {
            width: 36px;
            height: 36px;
        }

        .report-info h3 {
            font-size: 13px;
        }

        .report-info p {
            font-size: 11px;
        }
    }
    /*.main-content {
        margin: 30px auto;
    }*/
</style>

<div class="reports-wrapper">
    <div class="report-card">
        <!-- Header -->
        <div class="report-header">
            @*<div class="header-icon">
                    <i class="fas fa-chart-pie"></i>
                </div>*@
            <h2>e-Payment and e-Receipt</h2>
            @*<p>Choose the report you want to generate</p>*@
        </div>
        <div class="reports-grid">
            <a href="@Url.Action("ePaymentGenMonthly", "ePayment")" class="report-item">
                <div class="report-icon" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed);">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <div class="report-info">
                    <h3>📅 Monthly Return Tax Payment</h3>
                    @*<p>Monthly & quarterly filing summary</p>
                <span class="report-badge">GSTR · Compliance</span>*@
                </div>
                <div class="report-arrow">
                    <i class="fas fa-chevron-right"></i>
                </div>
            </a>
            <a href="@Url.Action("ePaymentGenYearly","ePayment")" class="report-item">
                <div class="report-icon" style="background: linear-gradient(135deg, #14b8a6, #0d9488);">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="report-info">
                    <h3>💳 Yearly Demand Payment</h3>
                </div>
                <div class="report-arrow">
                    <i class="fas fa-chevron-right"></i>
                </div>
            </a>
            <a href="@Url.Action("ViewPaymentReceipt","PTHome")" class="report-item">
                <div class="report-icon" style="background: linear-gradient(135deg, #14b8a6, #0d9488);">
                    <i class="fa fa-check"></i>
                </div>
                <div class="report-info">
                    <h3>✅ Check Payment Status</h3>
                </div>
                <div class="report-arrow">
                    <i class="fas fa-chevron-right"></i>
                </div>
            </a>
            @*<a href="/DealerReports/InvoiceAnalysis" class="report-item">
            <div class="report-icon" style="background: linear-gradient(135deg, #f97316, #ea580c);">
                <i class="fas fa-file-invoice"></i>
            </div>
            <div class="report-info">
                <h3>Invoice Analytics</h3>
                <p>Track invoice volumes & trends</p>
                <span class="report-badge">B2B · B2C</span>
            </div>
            <div class="report-arrow">
                <i class="fas fa-chevron-right"></i>
            </div>
        </a>

        <a href="/DealerReports/PaymentRecon" class="report-item">
            <div class="report-icon" style="background: linear-gradient(135deg, #ec489a, #db2777);">
                <i class="fas fa-hand-holding-usd"></i>
            </div>
            <div class="report-info">
                <h3>Payment Reconciliation</h3>
                <p>Match payments with liabilities</p>
                <span class="report-badge">Challan Status</span>
            </div>
            <div class="report-arrow">
                <i class="fas fa-chevron-right"></i>
            </div>
        </a>

        <a href="javascript:void(0);" class="report-item disabled">
            <div class="report-icon" style="background: linear-gradient(135deg, #9ca3af, #6b7280);">
                <i class="fas fa-chart-pie"></i>
            </div>
            <div class="report-info">
                <h3>Annual Summary</h3>
                <p>Yearly performance & audit reports</p>
                <span class="report-badge coming">Coming Soon</span>
            </div>
            <div class="report-arrow">
                <i class="fas fa-clock"></i>
            </div>
        </a>*@


        </div>
    </div>
</div>

