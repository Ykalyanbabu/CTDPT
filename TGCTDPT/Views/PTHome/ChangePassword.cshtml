@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/_InnerLayout1.cshtml";
}
<head>
    <style>
        .container {
            max-width  : 1400px !important;
            border-radius: 10px;
           
        }
    </style>
</head>
@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
        var NavigateUrl = '@Url.Action("Login", "PTHome")';
            ModernAlert.showAlert('Your Password has been Changed Successfully!', 'You will be redirected to Login Page shortly', 'Password Changed',
                {
                    autoClose: true,
                    duration: 1000,
                    redirectUrl: NavigateUrl
                }
            );
            $('.modern-close').hide();
        });
    </script>
}
@if (TempData["ErrorMessage"] != null)
{
    <script>
    document.addEventListener("DOMContentLoaded", function () {
        ModernAlert.showError(@Html.Raw(Json.Encode(TempData["ErrorMessage"])), 'Action Failed');
    });
    </script>
}

<link href="~/assets/css/passwordchange.css" rel="stylesheet" />

<div class="container ChangePassword">
    <div class="body-content">
        <div class="password-card-modern fade-in">
            <!-- Card Header -->
            <div class="card-header-modern">
                <h2><i class="fas fa-key mr-2"></i>Change Password</h2>
                <p>Update your account password securely</p>
            </div>

            @using (Html.BeginForm("ChangePassword", "PTHome", FormMethod.Post, new { @class = "form-container" }))
            {
                @Html.AntiForgeryToken()
                <div class="card-body-modern">
                    <div class="success-message-modern" id="successMessage">
                        <i class="fas fa-check-circle"></i>
                        <div>
                            <h4>Password Changed Successfully!</h4>
                            <p>Your password has been updated. You'll be redirected shortly.</p>
                        </div>
                    </div>

                    <div class="form-grid">

                        <div class="form-group-modern">
                            <label class="form-label-modern">
                                <i class="fas fa-id-card"></i> PTIN
                            </label>
                            <div class="input-wrapper-modern">
                                @Html.TextBox("UserId", null, new { @class = "form-input-modern", placeholder = "Enter PTIN", id = "PtinInput", @readonly = "readonly" })
                            </div>
                        </div>
                        <div class="form-group-modern">
                            <label class="form-label-modern">
                                <i class="fas fa-lock"></i> Current Password
                            </label>
                            <div class="input-wrapper-modern">
                                @Html.Password("OldPassword", null, new { @class = "form-input-modern", placeholder = "Enter current password", id = "oldPassword" })
                                <i class="fas fa-eye input-icon-modern" id="toggleOldPassword"></i>
                            </div>
                        </div>

                        <div class="form-group-modern">
                            <label class="form-label-modern">
                                <i class="fas fa-key"></i> New Password
                            </label>
                            <div class="input-wrapper-modern">
                                @Html.Password("NewPassword", null, new { @class = "form-input-modern", placeholder = "Enter new password", id = "newPassword" })
                                <i class="fas fa-eye input-icon-modern" id="toggleNewPassword"></i>
                            </div>
                            <div class="password-strength-modern" id="passwordStrength">
                                <div class="strength-bar-modern">
                                    <div class="strength-fill-modern" id="strengthFill"></div>
                                </div>
                                <div class="strength-text-modern" id="strengthText">Password strength</div>
                            </div>
                        </div>

                        <div class="form-group-modern">
                            <label class="form-label-modern">
                                <i class="fas fa-key"></i> Confirm Password
                            </label>
                            <div class="input-wrapper-modern">
                                @Html.Password("ConfirmPassword", null, new { @class = "form-input-modern", placeholder = "Confirm new password", id = "confirmPassword" })
                                <i class="fas fa-eye input-icon-modern" id="toggleConfirmPassword"></i>
                            </div>
                        </div>
                    </div>

                    <div class="requirements-box-modern" id="passwordRequirements">
                        <ul class="requirements-grid">
                            <li id="reqLength"><i class="fas fa-circle"></i> Minimum 8 characters</li>
                            <li id="reqNumber"><i class="fas fa-circle"></i> At least one number</li>
                            <li id="reqAlpha"><i class="fas fa-circle"></i> At least one letter</li>
                            <li id="reqMatch"><i class="fas fa-circle"></i> Passwords must match</li>
                        </ul>
                    </div>

                    <div class="btn-group-modern">
                        <button type="submit" class="btn-modern btn-primary-modern" id="submitBtn">
                            <i class="fas fa-save"></i> Update Password
                        </button>
                        <button type="button" class="btn-modern btn-secondary-modern" id="cancelBtn" onclick="window.history.back()">
                            <i class="fas fa-times"></i> Cancel
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
     var PTIN = '@Session["Tin"]';
    $(document).ready(function () {

        $('#PtinInput').val(PTIN);

        // Toggle password visibility
        function setupPasswordToggle(passwordId, toggleId) {
            $(toggleId).click(function () {
                const passwordInput = $(passwordId);
                const type = passwordInput.attr('type') === 'password' ? 'text' : 'password';
                passwordInput.attr('type', type);
                $(this).toggleClass('fa-eye fa-eye-slash');
            });
        }

        setupPasswordToggle('#oldPassword', '#toggleOldPassword');
        setupPasswordToggle('#newPassword', '#toggleNewPassword');
        setupPasswordToggle('#confirmPassword', '#toggleConfirmPassword');

        // Password strength checker
        function checkPasswordStrength(password) {
            let strength = 0;
            if (password.length >= 8) strength += 30;
            if (/[a-zA-Z]/.test(password)) strength += 35;
            if (/\d/.test(password)) strength += 35;
            return Math.min(strength, 100);
        }

        // Update password strength indicator
        $('#newPassword').on('input', function () {
            const password = $(this).val();
            const strength = checkPasswordStrength(password);
            const strengthFill = $('#strengthFill');
            const strengthText = $('#strengthText');

            if (password.length === 0) {
                $('#passwordStrength').hide();
                return;
            }

            $('#passwordStrength').show();
            strengthFill.css('width', strength + '%');

            // Update strength text and color
            let text = 'Weak';
            if (strength >= 80) {
                text = 'Strong';
                strengthFill.css('background', '#28a745');
            } else if (strength >= 60) {
                text = 'Good';
                strengthFill.css('background', '#28a745');
            } else if (strength >= 30) {
                text = 'Fair';
                strengthFill.css('background', '#ffc107');
            } else {
                strengthFill.css('background', '#dc3545');
            }

            strengthText.text('Password strength: ' + text);

            // Update requirements indicators
            updateRequirementsIndicators(password);
        });

        // Update requirements indicators
        function updateRequirementsIndicators(password) {
            const confirmPassword = $('#confirmPassword').val();

            // Length requirement
            if (password.length >= 8) {
                $('#reqLength i').removeClass('fa-circle').addClass('fa-check-circle');
                $('#reqLength').addClass('valid');
            } else {
                $('#reqLength i').removeClass('fa-check-circle').addClass('fa-circle');
                $('#reqLength').removeClass('valid');
            }

            // Alphabet requirement
            if (/[a-zA-Z]/.test(password)) {
                $('#reqAlpha i').removeClass('fa-circle').addClass('fa-check-circle');
                $('#reqAlpha').addClass('valid');
            } else {
                $('#reqAlpha i').removeClass('fa-check-circle').addClass('fa-circle');
                $('#reqAlpha').removeClass('valid');
            }

            // Number requirement
            if (/\d/.test(password)) {
                $('#reqNumber i').removeClass('fa-circle').addClass('fa-check-circle');
                $('#reqNumber').addClass('valid');
            } else {
                $('#reqNumber i').removeClass('fa-check-circle').addClass('fa-circle');
                $('#reqNumber').removeClass('valid');
            }

            // Match requirement
            if (password && confirmPassword && password === confirmPassword) {
                $('#reqMatch i').removeClass('fa-circle').addClass('fa-check-circle');
                $('#reqMatch').addClass('valid');
            } else {
                $('#reqMatch i').removeClass('fa-check-circle').addClass('fa-circle');
                $('#reqMatch').removeClass('valid');
            }
        }

        // Check password match
        $('#confirmPassword').on('input', function () {
            const newPassword = $('#newPassword').val();
            updateRequirementsIndicators(newPassword);
        });

        // Form validation
        $('#submitBtn').click(function (e) {
            e.preventDefault();

            const oldPassword = $('#oldPassword').val();
            const newPassword = $('#newPassword').val();
            const confirmPassword = $('#confirmPassword').val();

            if (!oldPassword) {
                if (typeof ModernAlert !== 'undefined') {
                    ModernAlert.toast.warning('Please enter your current password');
                } else {
                    alert('Please enter your current password');
                }
                $('#oldPassword').focus().addClass('shake');
                setTimeout(() => $('#oldPassword').removeClass('shake'), 500);
                return false;
            }

            if (!newPassword) {
                if (typeof ModernAlert !== 'undefined') {
                    ModernAlert.toast.warning('Please enter a new password');
                } else {
                    alert('Please enter a new password');
                }
                $('#newPassword').focus().addClass('shake');
                setTimeout(() => $('#newPassword').removeClass('shake'), 500);
                return false;
            }

            if (newPassword.length < 8) {
                if (typeof ModernAlert !== 'undefined') {
                    ModernAlert.toast.warning('Password must be at least 8 characters long');
                } else {
                    alert('Password must be at least 8 characters long');
                }
                $('#newPassword').focus().addClass('shake');
                setTimeout(() => $('#newPassword').removeClass('shake'), 500);
                return false;
            }

            if (!/[a-zA-Z]/.test(newPassword)) {
                if (typeof ModernAlert !== 'undefined') {
                    ModernAlert.toast.warning('Password must contain at least one letter');
                } else {
                    alert('Password must contain at least one letter');
                }
                $('#newPassword').focus().addClass('shake');
                setTimeout(() => $('#newPassword').removeClass('shake'), 500);
                return false;
            }

            if (!/\d/.test(newPassword)) {
                if (typeof ModernAlert !== 'undefined') {
                    ModernAlert.toast.warning('Password must contain at least one number');
                } else {
                    alert('Password must contain at least one number');
                }
                $('#newPassword').focus().addClass('shake');
                setTimeout(() => $('#newPassword').removeClass('shake'), 500);
                return false;
            }

            if (newPassword !== confirmPassword) {
                if (typeof ModernAlert !== 'undefined') {
                    ModernAlert.toast.warning('New password and confirmation do not match');
                } else {
                    alert('New password and confirmation do not match');
                }
                $('#confirmPassword').focus().addClass('shake');
                setTimeout(() => $('#confirmPassword').removeClass('shake'), 500);
                return false;
            }
            ModernAlert.showConfirm(
                'Are you sure you want to Change Password? This action cannot be undone.',
                'Confirm Submit',
                function (confirmed) {
                    if (confirmed) {
                        $('form').submit();
                    }
                    else {
                        ModernAlert.toast.info('Action cancelled');
                    }
                }
            );
           
        });
    });
</script>