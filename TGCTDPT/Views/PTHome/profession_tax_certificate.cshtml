
@{
    ViewBag.Title = "profession_tax_certificate";
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Profession Tax Payer Enrolment & Registration  Certificate</title>
    <style>
     * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: Arial, sans-serif;
      background: #f0f0f0;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 30px 20px;
      min-height: 100vh;
    }

    .print-btn {
      margin-bottom: 20px;
      padding: 10px 28px;
      background: #1a6e2a;
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 15px;
      cursor: pointer;
      transition: background 0.2s;
    }
    .print-btn:hover { background: #145520; }

    .certificate {
      background: white;
      width: 680px;
      max-width: 100%;
      padding: 36px 48px 48px;
      border: 1px solid #ccc;
      box-shadow: 0 2px 16px rgba(0,0,0,0.12);
    }

    .header {
      text-align: center;
      margin-bottom: 18px;
    }

    .header img {
      width: 64px;
      height: 64px;
      margin-bottom: 8px;
    }

    .header .emblem {
      width: 64px;
      height: 64px;
      margin: 0 auto 8px;
      background: radial-gradient(circle, #c8a800 30%, #8a6e00 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
    }

    .header h2 {
      font-size: 16px;
      font-weight: bold;
      color: #000;
      line-height: 1.6;
    }

    .header .sub {
      font-size: 13px;
      color: #333;
    }

    .header .form-title {
      font-size: 14px;
      font-weight: bold;
      margin-top: 4px;
      color: #000;
    }

    .cert-title {
      font-size: 17px;
      font-weight: bold;
      color: #000;
      margin-top: 2px;
    }

    .divider {
      border: none;
      border-top: 1px solid #333;
      margin: 14px 0;
    }

    .meta-row {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      margin-bottom: 10px;
    }

    .meta-row .left, .meta-row .right {
      display: flex;
      gap: 6px;
    }

    .meta-row .label { font-weight: normal; color: #000; }
    .meta-row .value { font-weight: bold; color: #000; }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 4px;
    }

    tr td {
      padding: 7px 4px;
      font-size: 13.5px;
      vertical-align: top;
      color: #000;
      border-bottom: 1px solid #eee;
    }

    tr:last-child td { border-bottom: none; }

    td.field-label {
      width: 42%;
      font-weight: bold;
    }

    td.colon {
      width: 4%;
      text-align: center;
    }

    td.field-value {
      width: 54%;
    }

    .notice {
      margin-top: 18px;
      font-size: 12.5px;
      color: #000;
      line-height: 1.6;
    }

    .notice strong { font-weight: bold; }

    .footer {
      display: flex;
      justify-content: space-between;
      margin-top: 28px;
      font-size: 13px;
      font-weight: bold;
    }

    @media print {
      body {
        background: white;
        padding: 0;
      }
      .print-btn { display: none; }
      .certificate {
        box-shadow: none;
        border: none;
        padding: 20px 40px;
      }
    }
    </style>
</head>
<body>


    <div class="certificate">
        <div class="header">
            <!-- Telangana emblem placeholder -->
            <div class="emblem">🏛️</div>
            <h2>Government of Telangana<br>Commercial Taxes Department</h2>
            <div class="sub">(Section 6 Read with Rule 4 )</div>
            <div class="form-title">FORM II A</div>
            <div class="cert-title">Profession Tax Payer Enrolment Certificate</div>
        </div>

        <hr class="divider" />

        <div class="meta-row">
            <div class="left">
                <span class="label">PTIN</span>
                <span>:</span>
                <span class="value">36440805739</span>
            </div>
            <div class="right">
                <span class="label">Date&amp;Time:</span>
                <span class="value">02-Jan-2026 05:20 PM</span>
            </div>
        </div>

        <div class="meta-row">
            <div class="left">
                <span class="label">Tax Division</span>
                <span>: MADHAPUR</span>
            </div>
            <div class="right">
                <span class="label">Tax Circle:</span>
                <span class="value">MADHAPUR 6</span>
            </div>
        </div>

        <hr class="divider" />

        <table>
            <tr>
                <td class="field-label">Name</td>
                <td class="colon">:</td>
                <td class="field-value">DUMMY</td>
            </tr>
            <tr>
                <td class="field-label">Main Profession</td>
                <td class="colon">:</td>
                <td class="field-value">ENTRY 2 I</td>
            </tr>
            <tr>
                <td class="field-label">Door No./Street Address</td>
                <td class="colon">:</td>
                <td class="field-value">1, NAMPALLY</td>
            </tr>
            <tr>
                <td class="field-label">City/Village/Locality</td>
                <td class="colon">:</td>
                <td class="field-value">HYDERABAD</td>
            </tr>
            <tr>
                <td class="field-label">Mandal/Municipality</td>
                <td class="colon">:</td>
                <td class="field-value">HYDERABAD</td>
            </tr>
            <tr>
                <td class="field-label">District</td>
                <td class="colon">:</td>
                <td class="field-value">HYDERABAD</td>
            </tr>
            <tr>
                <td class="field-label">PIN</td>
                <td class="colon">:</td>
                <td class="field-value">500001</td>
            </tr>
            <tr>
                <td class="field-label">Telephone/Mobile Number</td>
                <td class="colon">:</td>
                <td class="field-value">08341456271 / 1234567890</td>
            </tr>
            <tr>
                <td class="field-label">Email</td>
                <td class="colon">:</td>
                <td class="field-value">STO-MDPR6@TGCT.GOV.IN</td>
            </tr>
        </table>

        <div class="notice">
            The holder of this certificate shall abide by all the provisions of <strong>Telangana Tax on Profession Trade, Calling and Employment Act, 1987</strong> and the Rules framed there under as amended from time to time.
        </div>

        <div class="footer">
            <span>Date :</span>
            <span>Signature of Competent Authority</span>
        </div>
    </div>
    <div></div>
    <button class="meta-row" class="print-btn"   onclick="window.print()">🖨️ Print Certificate</button>

</body>
</html>
