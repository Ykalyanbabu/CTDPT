@model TGCTDPT.Models.RC_Details

@{
    ViewBag.Title = "profession_tax_certificate";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Profession Tax Certificate</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f0f0f0;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 30px 20px;
            min-height: 100vh;
        }

        .print-btn {
            margin-bottom: 20px;
            padding: 10px 28px;
            background: #1a6e2a;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 15px;
            cursor: pointer;
        }

            .print-btn:hover {
                background: #145520;
            }

        .certificate {
            background: white;
            width: 680px;
            max-width: 100%;
            padding: 36px 48px 48px;
            border: 1px solid #ccc;
            box-shadow: 0 2px 16px rgba(0,0,0,0.12);
        }

        .header {
            text-align: center;
            margin-bottom: 18px;
        }

            .header .emblem {
                width: 64px;
                height: 64px;
                margin: 0 auto 8px;
                background: radial-gradient(circle,#c8a800 30%,#8a6e00 100%);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 28px;
            }

            .header h2 {
                font-size: 16px;
                font-weight: bold;
                line-height: 1.6;
            }

        .sub {
            font-size: 13px;
        }

        .form-title {
            font-size: 14px;
            font-weight: bold;
            margin-top: 4px;
        }

        .cert-title {
            font-size: 17px;
            font-weight: bold;
            margin-top: 2px;
        }

        .divider {
            border: none;
            border-top: 1px solid #333;
            margin: 14px 0;
        }

        .meta-row {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            margin-bottom: 10px;
        }

            .meta-row .left, .meta-row .right {
                display: flex;
                gap: 6px;
            }

        .value {
            font-weight: bold;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 4px;
        }

        tr td {
            padding: 7px 4px;
            font-size: 13.5px;
            vertical-align: top;
            border-bottom: 1px solid #eee;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .field-label {
            width: 42%;
            font-weight: bold;
        }

        .colon {
            width: 4%;
            text-align: center;
        }

        .field-value {
            width: 54%;
        }

        .notice {
            margin-top: 18px;
            font-size: 12.5px;
            line-height: 1.6;
        }

        .footer {
            display: flex;
            justify-content: space-between;
            margin-top: 28px;
            font-size: 13px;
            font-weight: bold;
        }

        @@media print {

            body {
                background: white;
                padding: 0;
            }

            .print-btn {
                display: none;
            }

            .certificate {
                box-shadow: none;
                border: none;
                padding: 20px 40px;
            }
        }

        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%,-50%);
            opacity: 0.08;
            z-index: 0;
            pointer-events: none;
        }

            .watermark img {
                width: 350px;
                height: auto;
            }
    </style>

</head>

<body>


    <div class="certificate">

        <div class="watermark">
            <img src="@Url.Content("~/assets/images/logo.png")" />
        </div>

        <div class="header">

            <div class="emblem">
                <img src="@Url.Content("~/assets/images/logo.png")" alt="Telangana State Logo" />
            </div>

            <h2>
                Government of Telangana<br>
                Commercial Taxes Department
            </h2>

            <div class="sub">(Section 6 Read with Rule 4)</div>

            <div class="form-title">FORM I & FORM II </div>

            <div class="cert-title">
                Profession Tax Payer Registration Certificate
            </div>

        </div>

        <hr class="divider" />

        <div class="meta-row">

            <div class="left">
                <span>PTIN</span>
                <span>:</span>
                <span class="value">@Model.prof_tin</span>
            </div>

            <div class="right">
                <span>Date & Time :</span>
                <span class="value">@DateTime.Now.ToString("dd-MMM-yyyy hh:mm tt")</span>
            </div>

        </div>

        <div class="meta-row">

            <div class="left">
                <span>Tax Division</span>
                <span>: @Model.division_name</span>
            </div>

            <div class="right">
                <span>Tax Circle :</span>
                <span class="value">@Model.circle_name</span>
            </div>

        </div>

        <hr class="divider" />

        <table>

            <tr>
                <td class="field-label">Name</td>
                <td class="colon">:</td>
                <td class="field-value">@Model.enterprise_name</td>
            </tr>

            <tr>
                <td class="field-label">Main Profession</td>
                <td class="colon">:</td>
                <td class="field-value">@Model.Profession_Type</td>
            </tr>

            <tr>
                <td class="field-label">Door No./Street Address</td>
                <td class="colon">:</td>
                <td class="field-value">@Model.door_no,@Model.city</td>
            </tr>

            <tr>
                <td class="field-label">City/Village/Locality</td>
                <td class="colon">:</td>
                <td class="field-value">@Model.city</td>
            </tr>

            <tr>
                <td class="field-label">Mandal/Municipality</td>
                <td class="colon">:</td>
                <td class="field-value">@Model.mandal_code</td>
            </tr>

            <tr>
                <td class="field-label">District</td>
                <td class="colon">:</td>
                <td class="field-value">@Model.district_code</td>
            </tr>

            <tr>
                <td class="field-label">PIN</td>
                <td class="colon">:</td>
                <td class="field-value">@Model.pin</td>
            </tr>

            <tr>
                <td class="field-label">Telephone/Mobile Number</td>
                <td class="colon">:</td>
                <td class="field-value">@Model.phone_number / @Model.mobile_number</td>
            </tr>

            <tr>
                <td class="field-label">Email</td>
                <td class="colon">:</td>
                <td class="field-value">@Model.Email_Id</td>
            </tr>

        </table>

        <div class="notice">

            The holder of this certificate shall abide by all the provisions of
            <strong>Telangana Tax on Profession Trade, Calling and Employment Act, 1987</strong>
            and the Rules framed there under as amended from time to time.

        </div>

        <div class="footer">

            <span>Date : @DateTime.Now.ToString("dd-MMM-yyyy")</span>

            <span>This is System Generated, Signature Not Required</span>

        </div>

    </div>

    <button class="print-btn" onclick="window.print()">Print Certificate</button>

</body>
</html>