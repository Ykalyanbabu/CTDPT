@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_OuterLayout.cshtml";
}
<link href="~/assets/css/custom.css" rel="stylesheet" />
<style>
    .validation-summary-errors {
        color: red;
        font-weight: 600;
        margin: -25px auto 1px auto;
        width: fit-content;
    }

    .login-page-wrapper {
        min-height: calc(100vh - 120px); /* adjust 120px to match your header+nav height */
        /*display: flex;*/
        align-items: center;
        justify-content: center;
        padding: 0px 20px;
    }

    .login-card {
        display: flex;
        flex-direction: row;
        width: 860px;
        max-width: 100%;
        min-height: 480px;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,0.18);
        background: #fff;
    }

    .left-panel {
        width: 340px;
        min-width: 340px;
        background: #ffffff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        padding: 0 20px 28px 20px;
        position: relative;
        overflow: hidden;
        border-right: 1px solid #e2eaf4;
    }

    .collage-grid {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 70%;
        /*display: grid;*/
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr 1fr;
        gap: 3px;
    }

        .collage-grid .cell {
            overflow: hidden;
            background: #dde8f5;
        }

            .collage-grid .cell img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

    .left-branding {
        position: relative;
        z-index: 2;
        text-align: center;
        width: 100%;
    }

        .left-branding h2 {
            color: #1a4b7a;
            font-size: 16px;
            font-weight: 700;
            line-height: 1.3;
            margin-bottom: 3px;
        }

        .left-branding p {
            color: #444;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 14px;
        }

    .back-to-site-btn {
        border: 1.5px solid #1a4b7a;
        color: #1a4b7a;
        background: #fff;
        padding: 8px 18px;
        border-radius: 10px;
        font-size: 12px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s, color 0.2s;
    }

        .back-to-site-btn:hover {
            background: #1a4b7a;
            color: #fff;
        }

    .right-panel {
        flex: 1;
        /*background: #f0f6ff;*/
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px 44px;
    }

    .right-logos {
        display: flex;
        gap: 14px;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
    }

        .right-logos img {
            height: 54px;
            width: auto;
            object-fit: contain;
        }

    .page-title {
        font-size: 22px;
        font-weight: 700;
        color: #1a2e4a;
        text-align: center;
        margin-bottom: 2px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .page-title i {
            color: #75339b;
        }

    .page-subtitle {
        font-size: 12px;
        color: #888;
        text-align: center;
        margin-bottom: 24px;
    }

    .form-container {
        width: 100%;
        max-width: 320px;
    }

    .form-row {
        margin-bottom: 16px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .form-label {
        font-size: 12.5px;
        font-weight: 600;
        color: #475569;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .input-group {
        position: relative;
    }

    .form-input {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid #c8d8ed;
        border-radius: 8px;
        font-size: 13.5px;
        background: #fff;
        outline: none;
        color: #1a2e4a;
        transition: border 0.2s;
    }

        .form-input:focus {
            border-color: #75339b;
        }

    .password-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        color: #94a3b8;
        font-size: 14px;
    }

    .actions {
        margin-bottom: 14px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .login-btn {
        width: 100%;
        padding: 11px;
        background: #75339b;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        letter-spacing: 0.4px;
        transition: background 0.2s;
    }

        .login-btn:hover {
            background: #5e2880;
        }

    .login-help {
        text-align: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .help-links {
        display: flex;
        justify-content: center;
    }

    .help-link {
        color: #75339b;
        font-size: 12.5px;
        text-decoration: none;
        font-weight: 500;
    }

        .help-link:hover {
            text-decoration: underline;
        }
    @@media (max-width: 768px) {
        .left-panel {
            display: none;
        }

        .right-panel {
            width: 100%;
            padding: 30px 20px;
        }

        .login-card {
            width: 100%;
            max-width: 400px;
            margin: 0 auto;
            min-height: auto;
        }

        .page-title {
            font-size: 20px;
        }

        .page-subtitle {
            margin-bottom: 20px;
        }
    }
</style>

@if (TempData["ErrorMessage"] != null)
{
    <script>
    document.addEventListener("DOMContentLoaded", function () {
        ModernAlert.showError(@Html.Raw(Json.Encode(TempData["ErrorMessage"])), 'Login Failed');
    });
    </script>
}

<body>
    <div class="login-page-wrapper">
        <div class="login-card">
            <div class="left-panel">
                <div class="collage-grid">
                    <div class="cell"><img src="~/assets/images/map.jpg" alt="" /></div>
                </div>
                <div class="left-branding">
                    <h2>Commercial Taxes Department</h2>
                    <p>Government of Telangana</p>
                    <a href="@Url.Action("Home", "PTHome")" class="back-to-site-btn">
                        <i class="fas fa-home"></i> Back to Home
                    </a>
                </div>
            </div>
            <div class="right-panel">
                @*<div class="right-logos">
                        <img src="~/assets/images/telangana-rising-logo.png" alt="Telangana Rising" />
                        <img src="~/assets/images/dept-logo.png" alt="Department of Telangana" />
                    </div>*@

                <div class="page-title">
                    <i class="fas fa-user-circle"></i>
                    Dealer Login
                </div>
                <div class="page-subtitle">Access to Portal</div>

                @using (Html.BeginForm("Login", "PTHome", FormMethod.Post, new { @class = "form-container" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger validation-summary-errors" })

                    <div class="form-row">
                        <div class="form-label">
                            <i class="fas fa-id-card"></i>
                            PTIN / User ID
                        </div>
                        <div class="input-group">
                            @Html.TextBox("username", ViewBag.username as string, new { @class = "form-input", placeholder = "Enter PTIN or User ID" })
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-label">
                            <i class="fas fa-lock"></i>
                            Password
                        </div>
                        <div class="input-group">
                            @Html.Password("password", null, new { @class = "form-input", placeholder = "Enter Password", id = "passwordInput" })
                            <span class="password-toggle" id="passwordToggle">
                                <i class="fas fa-eye"></i>
                            </span>
                        </div>
                    </div>

                    <div class="actions">
                        <button type="submit" class="login-btn">
                            <i class="fas fa-sign-in-alt"></i>
                            Login
                        </button>
                    </div>

                    <div class="login-help">
                        <div class="help-links">
                            @Html.ActionLink("Forgot Password?", "ResetPassword", "PTHome", null, new { @class = "help-link" })
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const passwordInput = document.getElementById('passwordInput');
            const passwordToggle = document.getElementById('passwordToggle');
            const passwordIcon = passwordToggle.querySelector('i');

            passwordToggle.addEventListener('click', function () {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                if (type === 'text') {
                    passwordIcon.classList.remove('fa-eye');
                    passwordIcon.classList.add('fa-eye-slash');
                } else {
                    passwordIcon.classList.remove('fa-eye-slash');
                    passwordIcon.classList.add('fa-eye');
                }
            });

            const inputs = document.querySelectorAll('.form-input');
            inputs.forEach(input => {
                input.addEventListener('focus', function () {
                    const icon = this.parentElement.querySelector('.input-icon');
                    if (icon) icon.style.color = '#75339b';
                });
                input.addEventListener('blur', function () {
                    const icon = this.parentElement.querySelector('.input-icon');
                    if (icon && !this.value) icon.style.color = '#94a3b8';
                });
            });

            setTimeout(() => {
                document.querySelectorAll('.form-row, .note, .actions, .login-help').forEach(el => {
                    el.style.opacity = '1';
                });
            }, 100);
        });
    </script>

</body>