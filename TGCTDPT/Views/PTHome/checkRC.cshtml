
@model TGCTDPT.Models.RC_Details
@{
    ViewBag.Title = "checkRC";
    Layout = "~/Views/Shared/_InnerLayout.cshtml";
}

<link href="~/assets/css/custom.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>

    .actions {
        display: grid !important;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin-left: 200px;
        margin-bottom: 15px;
        align-content: end;
        justify-items: end;
        align-items: center;
        justify-content: space-evenly;
    }
</style>
<body>
    <div class="wrapper checkrc">
        <div class="card">
            <div class="section-title">PROFESSIONAL TAX CERTIFICATE</div>

            <div class="info">
                Below are the registration details available for the given PTIN.
                You may reprint the required certificate using the options provided.
            </div>

            <div class="section">
                <div class="section-header">
                    <i class="fas fa-home"></i>
                    <h2>Registration Details</h2>
                </div>

                <!-- Two Column Grid Layout -->
                <div class="form-grid">
                    <div class="form-row">
                        <label><i class="fas fa-hashtag"></i> PTIN</label>
                        <input type="text" id="prof_tin" value="@Model.prof_tin" readonly class="ptin-value">
                    </div>

                    <div class="form-row">
                        <label><i class="fas fa-user-tie"></i> Name of Person / Business</label>
                        <input type="text" id="enterprise_name" value="@Model.enterprise_name" readonly>
                    </div>

                    <div class="form-row">
                        <label><i class="fas fa-building"></i> Division</label>
                        <input type="text" id="division_name" value="@Model.division_name" readonly>
                    </div>

                    <div class="form-row">
                        <label><i class="fas fa-map-marker-alt"></i> Circle</label>
                        <input type="text" id="circle_name" value="@Model.circle_name" readonly>
                    </div>
                </div>


            </div>
        </div>
        <div class="actions-section">
            <!--<div class="actions-title">
                <i class="fas fa-print"></i>
                Certificate Reprint Options
            </div>-->

            <div class="actions">
                <button class="primary"
                        onclick="window.open('@Url.Action("PrintRC","PTHome")','_blank')">
                    <i class="fas fa-file-invoice"></i>
                    Print Certificate
                </button>
            </div>

            <!--<div class="status-indicator">
                <div class="status-item">
                    <span class="status-dot"></span>
                    <span>Active Registration</span>
                </div>
                <div class="status-item">
                    <i class="fas fa-clock"></i>
                    <span>Updated: 15 Jan 2024</span>
                </div>
            </div>-->
        </div>
    </div>
    </div>

    <script src="active.js"></script>


    <script>

    </script>
</body>

