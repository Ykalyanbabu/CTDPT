
@{
    ViewBag.Title = "ResetPassword";
    Layout = "~/Views/Shared/_OuterLayout.cshtml";
}
<head>
    <style>
        :root {
            --primary-color: #133cdb;
            --primary-dark: #0353cf;
            --primary-light: #e6f4f3;
            --secondary-color: #2c3e50;
            --accent-color: #0b5ed7;
            --text-dark: #333;
            --text-light: #666;
            --border-color: #e1e5e9;
            --success-color: #28a745;
            --warning-color: #ffc107;
            --radius-sm: 8px;
            --radius-md: 10px;
            --shadow-sm: 0 4px 12px rgba(0,0,0,0.05);
            --shadow-md: 0 6px 20px rgba(0,0,0,0.08);
            --transition: all 0.3s ease;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            color: var(--text-dark);
            line-height: 1.6;
            min-height: 100vh;
        }

        /* MAIN CONTENT */
        .container {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: calc(100vh - 160px);
            padding: 20px;
        }

        .body-content {
            width: 100%;
            max-width: 500px;
        }

        /* CARD DESIGN */
        .forgot-card {
            background: white;
            border-radius: 12px;
            box-shadow: var(--shadow-md);
            overflow: hidden;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .card-header {
            background: linear-gradient(135deg, #500b8b, #7d10b9);
            color: white;
            padding: 5px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .card-header::before {
                content: '';
                position: absolute;
                top: -50%;
                right: -50%;
                width: 200%;
                height: 200%;
                background: radial-gradient(circle, rgba(255,255,255,0.1) 1px, transparent 1px);
                background-size: 20px 20px;
                opacity: 0.1;
            }

        .card-icon {
            width: 60px;
            height: 60px;
            background: rgba(255,255,255,0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            font-size: 24px;
        }

        .page-title {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .page-subtitle {
            font-size: 14px;
            opacity: 0.9;
            font-weight: 400;
        }

        .card-body {
            padding: 30px;
        }

        /* FORM STYLING */
        .form-group {
            margin-bottom: 22px;
            position: relative;
        }

        .form-label {
            display: block;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 8px;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .form-label i {
                color: #c72ce1;
                font-size: 16px;
            }

        .form-input {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e1e5ea;
            border-radius: var(--radius-sm);
            font-size: 15px;
            transition: var(--transition);
            background: white;
        }

            .form-input:focus {
                outline: none;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 3px rgba(19, 60, 219, 0.1);
            }

            .form-input[readonly] {
                background: #f8f9fa;
                color: #666;
                border-color: #dee2e6;
            }

        .input-with-icon {
            position: relative;
        }

        .input-icon {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #666;
            font-size: 16px;
        }

        /* NOTE BOX */
        .note-box {
            background: #f8f9fa;
            border-left: 4px solid var(--primary-color);
            padding: 12px 16px;
            border-radius: 6px;
            margin: 15px 0;
            font-size: 13px;
            color: #666;
        }

            .note-box i {
                color: var(--primary-color);
                margin-right: 8px;
            }

        /* BUTTONS */
        .btn-group {
            display: flex;
            gap: 12px;
            margin-top: 30px;
        }

        .btn {
            flex: 1;
            padding: 14px 20px;
            border-radius: var(--radius-sm);
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
        }

        .btn-primary {
            background: linear-gradient(135deg, #500b8b, #7d10b9);
            color: white;
            box-shadow: 0 4px 12px rgba(19, 60, 219, 0.2);
        }

            .btn-primary:hover {
                background: linear-gradient(135deg, #7c0a61, #820ea2);
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(19, 60, 219, 0.3);
            }

        .btn-secondary {
            background: #6c757d;
            color: white;
            box-shadow: 0 4px 12px rgba(108, 117, 125, 0.2);
        }

            .btn-secondary:hover {
                background: #5a6268;
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(108, 117, 125, 0.3);
            }

        /* STEP INDICATOR */
        .step-indicator {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
            position: relative;
        }

        .step {
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            z-index: 2;
        }

        .step-number {
            width: 36px;
            height: 36px;
            background: #e9ecef;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: #666;
            margin-bottom: 8px;
            border: 3px solid white;
            transition: var(--transition);
        }

        .step.active .step-number {
            background: #d70089;
            color: white;
        }

        .step.completed .step-number {
            background: var(--success-color);
            color: white;
        }

        .step-text {
            font-size: 12px;
            font-weight: 600;
            color: #666;
            text-align: center;
        }

        .step.active .step-text {
            color: var(--primary-color);
        }

        .step-line {
            position: absolute;
            top: 18px;
            left: 50px;
            right: 50px;
            height: 2px;
            background: #e9ecef;
            z-index: 1;
        }

        /* OTP INPUT STYLING */
        .otp-container {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin-top: 10px;
        }

        .otp-input {
            width: 50px;
            height: 50px;
            text-align: center;
            font-size: 20px;
            font-weight: 600;
            border: 2px solid #e1e5ea;
            border-radius: 8px;
            background: white;
            transition: var(--transition);
        }

            .otp-input:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 3px rgba(19, 60, 219, 0.1);
                outline: none;
            }

        /* TIMER */
        .timer {
            text-align: center;
            font-size: 14px;
            color: #666;
            margin: 10px 0;
            font-weight: 500;
        }

            .timer span {
                color: var(--primary-color);
                font-weight: 700;
            }

        /* RESPONSIVE */
        @@media (max-width: 768px) {
            .container {
                padding: 15px;
            }

            .card-header {
                padding: 20px;
            }

            .card-body {
                padding: 20px;
            }

            .btn-group {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }

            .step-indicator {
                gap: 15px;
            }

            .step-line {
                left: 40px;
                right: 40px;
            }

            .otp-input {
                width: 45px;
                height: 45px;
                font-size: 18px;
            }
        }

        @@media (max-width: 480px) {
            .card-header {
                padding: 15px;
            }

            .page-title {
                font-size: 20px;
            }

            .step-indicator {
                gap: 10px;
            }

            .step-line {
                left: 30px;
                right: 30px;
            }

            .step-number {
                width: 32px;
                height: 32px;
                font-size: 14px;
            }

            .otp-input {
                width: 40px;
                height: 40px;
                font-size: 16px;
            }
        }

        /* ANIMATIONS */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in {
            animation: fadeIn 0.4s ease;
        }

        /* BACK LINK */
        .back-link {
            text-align: center;
            margin-top: 25px;
            font-size: 14px;
        }

            .back-link a {
                color: var(--primary-color);
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-weight: 500;
            }

                .back-link a:hover {
                    text-decoration: underline;
                }
    </style>
</head>
<body>
    <div class="container">
        <div class="body-content">
            <div class="forgot-card fade-in">
                <!-- Card Header -->
                <div class="card-header">
                    <!--<div class="card-icon">
                        <i class="fas fa-lock"></i>
                    </div>-->
                    <h2 class="page-title">Reset Your Password</h2>
                    <p class="page-subtitle">Secure your account with a new password</p>
                </div>

                <!-- Card Body -->
                <div class="card-body">
                    <!-- Step Indicator -->
                    <!-- Step 1: Verify Identity -->
                    <div id="step1-content">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-id-card"></i> PTIN
                            </label>
                            <div class="input-with-icon">
                                <input type="text" class="form-input" id="txtPtin" placeholder="Enter PTIN Here">
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-email-alt"></i> Registered Email
                            </label>
                            <div class="input-with-icon">
                                <input type="email" class="form-input" id="txtMail" placeholder="Enter Regsitered Email">
                            </div>
                        </div>
                    </div>

                    <div id="step3-content" style="display: block;">
                        <div class="btn-group">
                            <button class="btn btn-primary" id="btnSubmitFinal" onclick="onResetPassword()">
                                <i class="fas fa-check-circle"></i> Reset Password
                            </button>
                        </div>
                    </div>

                    <!-- Back to Login Link -->
                    <div class="back-link">
                        <a href="@Url.Action("Login", "PTHome")">
                            <i class="fas fa-arrow-left"></i> Back to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        function onResetPassword() {
            var ptin = $('#txtPtin').val();
            var email = $('#txtMail').val();
            $.ajax({
                url: '@Url.Action("GetPTINDetails", "PTHome")',
                dataType: 'json',
                data: {
                    PTIN: ptin
                },
                success: function (response) {
                    if (response.length > 0) {
                        if (email != response[0].email_id) {
                            ModernAlert.showError('Enter e-Mail ID Registered with Department at the time of Registration', 'e-Mail Id Not Matched');
                            return false;
                        }
                        else {
                            UpdatePassword(ptin, response[0].email_id);
                        }
                    }
                    else {
                        ModernAlert.showError('Please enter Valid PTIN', 'PTIN Not Found');
                    }
                },
                error: function (error) {
                    console.error(error);
                }
            });
        }

        function UpdatePassword(ptin, email) {
            $.ajax({
                url: '@Url.Action("ResetPassword", "PTHome")',
                type: 'POST',
                dataType: 'json',
                data: {
                    PTIN: ptin,
                    Email: email
                },
                success: function (response) {
                    if (response.success) {
                        ModernAlert.showConfirm(
                            response.message + "   Do you want to Login?",
                            'Password Reset',
                            function (confirmed) {
                                if (confirmed) {
                                    window.location.href = '@Url.Action("Login", "PTHome")?ptin=' + encodeURIComponent(ptin);
                                }
                            }
                        );
                    }
                    else {
                        ModernAlert.showError(response.message, 'Action Failed');
                    }
                },
                error: function (error) {
                    console.error(error);
                }
            });
        }
    </script>
</body>

