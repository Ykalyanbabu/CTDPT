
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_InnerLayout1.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
<!-- Google Fonts for modern typography -->
<link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
<style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

       /* body {
            background: radial-gradient(circle at 10% 30%, #f0f4ff, #faf5ff);
            font-family: 'Inter', 'Segoe UI', sans-serif;
            padding: 2rem 1.5rem;
            min-height: 100vh;
        }
*/
        /* smooth container */
        .compact-dashboard {
            max-width: 1300px;
            margin: 0 auto;
        }
    .main-content {
        margin: 30px auto !important;
    }

        /* modern heading area */
        .dashboard-header {
            margin-bottom: 2.5rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .title-section h1 {
            font-size: 1.9rem;
            font-weight: 700;
            background: linear-gradient(135deg, #1E2F5E, #6a1b9a);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: -0.3px;
            margin-bottom: 0.25rem;
        }

        .title-section p {
            color: #4b5563;
            font-weight: 500;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .title-section p i {
            color: #8b5cf6;
            font-size: 0.85rem;
        }

        .badge-date {
            background: rgba(255,255,240,0.7);
            backdrop-filter: blur(4px);
            padding: 8px 18px;
            border-radius: 80px;
            font-size: 0.8rem;
            font-weight: 500;
            color: #2c3e66;
            border: 1px solid rgba(99, 102, 241, 0.3);
            box-shadow: 0 2px 6px rgba(0,0,0,0.02);
        }

        /* GRID — modern, clean, responsive */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 26px;
        }

        /* card modern glassmorphism + soft shadow */
    .dashboard-card {
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(8px);
        border-radius: 28px;
        padding: 1.4rem 1.2rem 1.4rem 1.2rem;
        cursor: pointer;
        transition: all 0.35s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        border: 1px solid rgb(222 152 152 / 60%);
        box-shadow: 0 12px 28px -8px rgba(0, 0, 0, 0.07), 0 0 0 1px rgba(0, 0, 0, 0.01);
        display: flex;
        align-items: center;
        gap: 1.2rem;
        position: relative;
        overflow: hidden;
    }

        /* animated gradient border on hover */
        .dashboard-card::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 28px;
            padding: 2px;
            background: linear-gradient(125deg, #3b82f6, #a855f7, #f97316);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            opacity: 0;
            transition: opacity 0.4s;
            pointer-events: none;
        }

        .dashboard-card:hover::after {
            opacity: 1;
        }

        .dashboard-card:hover {
            transform: translateY(-6px);
            background: rgba(255, 255, 255, 0.98);
            box-shadow: 0 28px 36px -14px rgba(0, 0, 0, 0.2), 0 0 0 1px rgba(139, 92, 246, 0.2);
        }

        /* icon container modern */
        .card-icon {
            width: 58px;
            height: 58px;
            background: linear-gradient(145deg, #4f46e5, #c241fc);
            border-radius: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            color: white;
            box-shadow: 0 12px 18px -8px rgba(79, 70, 229, 0.4);
            transition: all 0.25s ease;
            flex-shrink: 0;
        }

        .dashboard-card:hover .card-icon {
            transform: scale(1.02) rotate(-2deg);
            background: linear-gradient(145deg, #6366f1, #d946ef);
            box-shadow: 0 14px 22px -8px rgba(99, 102, 241, 0.5);
        }

        /* text area */
        .card-text {
            flex: 1;
        }

        .card-text h3 {
            font-size: 1.1rem;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.2px;
            margin-bottom: 6px;
            line-height: 1.3;
        }

        .card-text p {
            font-size: 0.75rem;
            color: #5b6e8c;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 6px;
            opacity: 0.75;
        }

        .card-text p i {
            font-size: 0.7rem;
            color: #8b5cf6;
        }

        /* subtle badge (optional) */
        .trend-badge {
            background: #eef2ff;
            border-radius: 40px;
            padding: 4px 8px;
            font-size: 0.7rem;
            font-weight: 600;
            color: #4f46e5;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-top: 8px;
        }

        /* entrance animation */
        @@keyframes cardGlide {
            0% {
                opacity: 0;
                transform: translateY(18px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .dashboard-card {
            animation: cardGlide 0.45s ease forwards;
            opacity: 0;
        }

        .dashboard-card:nth-child(1) { animation-delay: 0.02s; }
        .dashboard-card:nth-child(2) { animation-delay: 0.07s; }
        .dashboard-card:nth-child(3) { animation-delay: 0.12s; }
        .dashboard-card:nth-child(4) { animation-delay: 0.17s; }
        .dashboard-card:nth-child(5) { animation-delay: 0.22s; }
        .dashboard-card:nth-child(6) { animation-delay: 0.27s; }
        .dashboard-card:nth-child(7) { animation-delay: 0.32s; }
        .dashboard-card:nth-child(8) { animation-delay: 0.37s; }
        .dashboard-card:nth-child(9) { animation-delay: 0.42s; }

        /* responsive adjustments */
        @@media (max-width: 720px) {
            body {
                padding: 1.2rem;
            }
            .dashboard-card {
                padding: 1rem;
                gap: 0.9rem;
            }
            .card-icon {
                width: 48px;
                height: 48px;
                font-size: 22px;
                border-radius: 18px;
            }
            .card-text h3 {
                font-size: 0.95rem;
            }
            .title-section h1 {
                font-size: 1.55rem;
            }
        }

        @@media (max-width: 480px) {
            .dashboard-grid {
                gap: 18px;
            }
            .badge-date {
                font-size: 0.7rem;
                padding: 4px 12px;
            }
        }

        /* custom subtle hover micro tip */
        .dashboard-card:active {
            transform: scale(0.98);
            transition: 0.08s linear;
        }

        /* logout pill (if needed, but without breaking anything) */
        .logout-area {
            display: flex;
            justify-content: flex-end;
            margin-top: 3rem;
        }
        .logout-btn {
            background: rgba(0,0,0,0.03);
            border: 1px solid rgba(0,0,0,0.08);
            padding: 8px 24px;
            border-radius: 60px;
            font-weight: 500;
            color: #475569;
            transition: 0.2s;
            cursor: pointer;
            font-size: 0.8rem;
            backdrop-filter: blur(4px);
        }
        .logout-btn:hover {
            background: #f1f5f9;
            color: #dc2626;
            border-color: #fecaca;
        }
        i.fa, i.far, i.fas {
            pointer-events: none;
        }
        /* small tooltip feel */
        [data-tooltip] {
            position: relative;
        }
</style>
<body>


    <div class="compact-dashboard">
       

        <div class="dashboard-grid">
            <div class="dashboard-card" onclick="location.href='@Url.Action("UpdateEmpDirector","ePayment")'">
                <div class="card-icon"><i class="fas fa-user-pen"></i></div>
                <div class="card-text">
                    <h3>Update Emp / Director / Partner</h3>
                    @*<p><i class="fas fa-sync-alt"></i> Modify KYC & stakeholder info</p>*@
                    @*<div class="trend-badge"><i class="fas fa-arrow-right"></i> instant update</div>*@
                </div>
            </div>

            <div class="dashboard-card" onclick="location.href='@Url.Action("checkRC","Registration")'">
                <div class="card-icon"><i class="fas fa-check-double"></i></div>
                <div class="card-text">
                    <h3>Check RC</h3>
                    @*<p><i class="fas fa-shield-alt"></i> Registration certificate status</p>*@
                </div>
            </div>

            <div class="dashboard-card" onclick="location.href='@Url.Action("Return", "Return")'">
                <div class="card-icon"><i class="fas fa-chart-simple"></i></div>
                <div class="card-text">
                    <h3>Returns</h3>
                </div>
            </div>

            <div class="dashboard-card" onclick="location.href='@Url.Action("DealerReportType","DealerReports")'">
                <div class="card-icon"><i class="fas fa-chart-line"></i></div>
                <div class="card-text">
                    <h3>Reports</h3>
                    
                </div>
            </div>

            <div class="dashboard-card" onclick="location.href='@Url.Action("PaymentType","PTHome")'">
                <div class="card-icon"><i class="fas fa-credit-card"></i></div>
                <div class="card-text">
                    <h3>E-Payment</h3>
                    
                </div>
            </div>

            <div class="dashboard-card" onclick="location.href='@Url.Action("AmendmentRequest","Amendments")'">
                <div class="card-icon"><i class="fas fa-file-signature"></i></div>
                <div class="card-text">
                    <h3>Amend Registration</h3>
                    
                </div>
            </div>

            <div class="dashboard-card" onclick="location.href='@Url.Action("ChangePassword","PTHome")'">
                <div class="card-icon"><i class="fas fa-key"></i></div>
                <div class="card-text">
                    <h3>Change Password</h3>
                   
                </div>
            </div>

            <div class="dashboard-card" onclick="location.href='@Url.Action("Refunds","Refunds")'">
                <div class="card-icon"><i class="fas fa-hand-holding-usd"></i></div>
                <div class="card-text">
                    <h3>Refunds</h3>
                   
                </div>
            </div>

            <div class="dashboard-card" onclick="location.href='@Url.Action("Cancel_PTIN","Modify_PTIN_Status")'">
                <div class="card-icon"><i class="fas fa-ban"></i></div>
                <div class="card-text">
                    <h3>PTIN Cancellation</h3>
                    
                </div>
            </div>
        </div>

        @*<div class="logout-area">
            <div class="logout-btn" onclick="logout()">
                <i class="fas fa-sign-out-alt"></i> Secure logout
            </div>
        </div>*@
    </div>

    <script>
    function setLiveDate() {
        const dateElem = document.getElementById('liveDate');
        if(dateElem) {
            const options = { year: 'numeric', month: 'long', day: 'numeric' };
            const today = new Date().toLocaleDateString(undefined, options);
            dateElem.innerText = today;
        }
    }
    setLiveDate();

    function goTo(url) {
        if(url) window.location.href = url;
    }

    function logout() {
       
        if(confirm("Are you sure you want to logout?")) {
           
            window.location.href = '@Url.Action("Logout", "Account")';
            
            setTimeout(() => {
              
                if(window.location.href.indexOf('Logout') === -1) {
                    window.location.href = 'Login.html';
                }
            }, 100);
        }
    }

    const cards = document.querySelectorAll('.dashboard-card');
    cards.forEach(card => {
        card.addEventListener('click', function(e) {
            let ripple = document.createElement('span');
            ripple.classList.add('ripple-effect');
            ripple.style.position = 'absolute';
            ripple.style.borderRadius = '50%';
            ripple.style.backgroundColor = 'rgba(99,102,241,0.3)';
            ripple.style.pointerEvents = 'none';
            ripple.style.width = '20px';
            ripple.style.height = '20px';
            ripple.style.transform = 'scale(0)';
            ripple.style.transition = 'transform 0.4s ease-out, opacity 0.5s';
            ripple.style.opacity = '1';
            const rect = e.currentTarget.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            ripple.style.left = `${x}px`;
            ripple.style.top = `${y}px`;
            card.style.position = 'relative';
            card.style.overflow = 'hidden';
            card.appendChild(ripple);
            setTimeout(() => {
                ripple.style.transform = 'scale(25)';
                ripple.style.opacity = '0';
            }, 10);
            setTimeout(() => {
                if(ripple && ripple.remove) ripple.remove();
            }, 400);
        });
    });

    console.log("Modern dashboard ready — premium glassmorphic UI");
    </script>



    <style>
    .ripple-effect {
        position: absolute;
        background: radial-gradient(circle, rgba(139,92,246,0.35) 0%, rgba(79,70,229,0.2) 80%);
        transform: scale(0);
        border-radius: 50%;
        pointer-events: none;
        z-index: 10;
    }
    .dashboard-card {
        position: relative;
        overflow: hidden;
    }
    .logout-btn {
        transition: all 0.2s;
        font-weight: 500;
        background: rgba(255,255,245,0.6);
        backdrop-filter: blur(12px);
        font-family: inherit;
    }
    .logout-btn:hover {
        background: #fee2e2;
        transform: translateY(-2px);
    }
    /* ensure responsiveness for 2k screens */
    @@media (min-width: 1600px) {
        .dashboard-grid {
            grid-template-columns: repeat(3, 1fr);
        }
        .compact-dashboard {
            max-width: 1500px;
        }
    }
    /* a nice glow for icons */
    .card-icon i {
        filter: drop-shadow(0 2px 2px rgba(0,0,0,0.1));
    }
    /* update subtle link styling */
    a, div[onclick] {
        cursor: pointer;
    }
    .badge-date i {
        margin-right: 6px;
    }
    </style>

</body>