@model TGCTDPT.Models.RC_Cancel_ReActivate_Details

@{
    ViewBag.Title = "Request Details";
    Layout = "~/Views/Shared/_DeptLayout.cshtml";
}

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary: #1d4ed8;
            --success: #059669;
            --danger: #b91c1c;
            --border: #e5e7eb;
            --light: #f9fafb;
        }

        .container {
            max-width: 1100px;
            margin: auto;
            padding: 20px;
        }

        .header {
            background: white;
            padding: 15px;
            border-radius: 10px;
            border: 1px solid var(--border);
            text-align: center;
            margin-bottom: 15px;
        }

        .main-box {
            display: flex;
            gap: 20px;
        }

        /* LEFT SIDE TABLE */
        .details-box {
            width: 45%;
            background: white;
            border-radius: 10px;
            border: 1px solid var(--border);
            padding: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

            table td {
                padding: 10px;
                border-bottom: 1px solid var(--border);
                font-size: 13px;
            }

                table td:first-child {
                    font-weight: bold;
                    width: 45%;
                    background: #f9fafb;
                }

        /* RIGHT SIDE DOCUMENT */
        .doc-box {
            width: 55%;
            background: white;
            border-radius: 10px;
            border: 1px solid var(--border);
            padding: 15px;
        }

        iframe {
            width: 100%;
            height: 500px;
            border: 1px solid var(--border);
            border-radius: 6px;
        }

        /* BUTTONS */
        .btn {
            padding: 8px 12px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            font-size: 13px;
        }

        .btn-success {
            background: var(--success);
            color: white;
        }

        .btn-danger {
            background: var(--danger);
            color: white;
        }

        .btn-download {
            background: var(--primary);
            color: white;
        }

        .action-btns {
            display: flex;
            gap: 10px;
        }

        .action-row td {
            padding-top: 15px;
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="header">
            <h2>PTIN Cancel Request Details</h2>
        </div>

        <div class="main-box">

            <div class="details-box">

                <table>

                    <tr>
                        <td>PTIN</td>
                        <td>@Model.prof_tin</td>
                    </tr>

                    <tr>
                        <td>Registration Date</td>
                        <td>@Model.edr</td>
                    </tr>

                    <tr>
                        <td>Effective Cancellation Date</td>
                        <td>@Model.effective_date.ToString("dd-MM-yyyy")</td>
                    </tr>

                    <tr>
                        <td>Reason</td>
                        <td>@Model.reason</td>
                    </tr>

                    <tr>
                        <td>Status</td>
                        <td>@Model.request_status</td>
                    </tr>

                    <tr class="action-row">
                        <td>Actions</td>
                        <td>
                            <div class="action-btns">
                                <button class="btn btn-success" onclick="approve(@Model.request_id)">
                                    <i class="fas fa-check"></i> Approve
                                </button>

                                <button class="btn btn-danger" onclick="reject(@Model.request_id)">
                                    <i class="fas fa-times"></i> Reject
                                </button>
                            </div>
                        </td>
                    </tr>

                </table>

            </div>

            <div class="doc-box">

                <h4>Document Preview</h4>

                @if (!string.IsNullOrEmpty(Model.doc_path))
                {
                    <iframe src="@Url.Content(Model.doc_path)"></iframe>

                    <br /><br />

                    <a href="@Url.Content(Model.doc_path)" target="_blank" class="btn btn-download">
                        <i class="fas fa-download"></i> Download Document
                    </a>
                }
                else
                {
                    <p style="color:red;">No document uploaded</p>
                }

            </div>

        </div>

    </div>

    <script>

        function approve(id) {
            ModernAlert.showConfirm(
                'Are you sure you want to Approve this request?',
                'Confirm Request',
                function (confirmed) {
                    if (confirmed) {
                        $.post('@Url.Action("ApprovePTINCancelRequest", "PTOfficer")',
                            { id: id, r_status: 'A' },
                            function (res) {
                                alert(res.message);
                                location.href = '@Url.Action("Pending_Cancel_Revoke_Requests", "PTOfficer")';
                            });
                    }
                    else {
                        ModernAlert.toast.info('Action cancelled');
                    }
                }
            );
        }

        function reject(id) {
            ModernAlert.showConfirm(
                'Are you sure you want to Reject The Request?',
                'Confirm Request',
                function (confirmed) {
                    if (confirmed) {
                        $.post('@Url.Action("ApprovePTINCancelRequest", "PTOfficer")',
                            { id: id, r_status: 'R' },
                            function (res) {
                                alert(res.message);
                                location.href = '@Url.Action("Pending_Cancel_Revoke_Requests", "PTOfficer")';
                            });
                    }
                    else {
                        ModernAlert.toast.info('Action cancelled');
                    }
                }
            );
        }

    </script>

</body>