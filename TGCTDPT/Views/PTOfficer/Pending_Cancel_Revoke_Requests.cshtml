@model List<TGCTDPT.Models.RC_Cancel_ReActivate_Details>

@{
    ViewBag.Title = "Pending PTIN Requests";
    Layout = "~/Views/Shared/_DeptLayout.cshtml";
}

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary: #1d4ed8;
            --success: #059669;
            --danger: #b91c1c;
            --border: #e5e7eb;
            --light: #f9fafb;
        }

        .summary-container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 20px;
        }

        .page-header {
            background: white;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
            border: 1px solid var(--border);
            text-align: center;
        }

            .page-header h1 {
                font-size: 20px;
                font-weight: 700;
            }

        .section {
            background: white;
            border-radius: 10px;
            border: 1px solid var(--border);
            overflow: hidden;
        }

        .section-header {
            padding: 10px 15px;
            background: #92b7ff;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .section-body {
            padding: 15px;
        }

        /* TABLE */
        .bank-table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow: hidden;
            font-size: 13px;
            background: white;
        }

            .bank-table thead tr {
                background-color: #7a7a7a;
            }

            .bank-table thead th {
                padding: 10px;
                text-align: left;
                color: white;
                border-right: 1px solid var(--border);
            }

            .bank-table tbody td {
                padding: 10px;
                border-right: 1px solid var(--border);
                border-bottom: 1px solid var(--border);
            }

            .bank-table tbody tr:nth-child(even) {
                background: #fafafa;
            }

            .bank-table tbody tr:hover {
                background: #eef4ff;
            }

            .bank-table th:last-child,
            .bank-table td:last-child {
                border-right: none;
            }

        /* BADGES */
        .badge {
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 11px;
            font-weight: bold;
        }

        .badge-green {
            background: #d1fae5;
            color: #065f46;
        }

        .badge-red {
            background: #fee2e2;
            color: #b91c1c;
        }

        .badge-gray {
            background: #e5e7eb;
            color: #374151;
        }

        /* BUTTON */
        .btn {
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 12px;
            border: none;
            cursor: pointer;
            text-decoration: none;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
        }

            .btn-primary:hover {
                background: #163db5;
            }

        .empty-row {
            text-align: center;
            padding: 20px;
            color: gray;
        }

        .mono-val {
            font-family: monospace;
            font-weight: 600;
        }
    </style>
</head>

<body>

    <div class="summary-container">

        <!-- HEADER -->
        <div class="page-header">
            <h1>  Pending PTIN Cancel Requests</h1>
        </div>

        <!-- TABLE SECTION -->
        <div class="section">

            <div class="section-header">
                <i class="fas fa-clock"></i> Request List
            </div>

            <div class="section-body">

                <div style="overflow-x:auto;">
                    <table class="bank-table">

                        <thead>
                            <tr>
                                <th style="width:120px;">PTIN</th>
                                <th>Registration Date</th>
                                <th>Cancellation Effective From Date</th>
                                <th style="width:120px;">Reason</th>
                                <th style="width:100px;">Status</th>
                                <th style="width:120px; text-align:center;">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>

                                        <td class="mono-val">@item.prof_tin</td>
                                        <td>@item.edr.ToString("dd-MM-yyyy")</td>
                                        <td>@item.effective_date.ToString("dd-MM-yyyy")</td>
                                        <td class="mono-val">@item.reason</td>
                                        @*<td>
                                                <span class="badge @(item.request_type == "CANCEL" ? "badge-red" : "badge-green")">
                                                    @item.request_type
                                                </span>
                                            </td>*@

                                        <td>
                                            <span class="badge badge-gray">
                                                @item.request_status
                                            </span>
                                        </td>

                                        @*<td>
                                                @item.effective_date.ToString("dd-MM-yyyy")
                                            </td>*@

                                        <td style="text-align:center;">
                                            <a href="@Url.Action("RequestDetails", "PTOfficer", new { id = item.request_id })"
                                               class="btn btn-primary">
                                                <i class="fas fa-eye"></i> View
                                            </a>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="empty-row">
                                        <i class="fas fa-info-circle"></i> No Pending Requests Found
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>
                </div>

            </div>
        </div>

    </div>

</body>