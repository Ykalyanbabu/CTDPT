                                    </thead>
                                    <tbody id="FilesBody">
                                        <tr id="noDataRowFiles">
                                            <td colspan="5" class="text-center text-muted">
                                                No Files added
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                    <div class="action-buttons" style="margin: 5px 0px 0px 0px;">
                        <button class="btn btn-primary" id="btnApprove"  style="background-color: #8f0aa7; width: 15%;">Approve</button>
                        <button class="btn btn-primary" id="btnReject"  style="background-color: #8f0aa7; width: 15%;">Reject</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
</body>