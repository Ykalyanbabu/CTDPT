                                    <div class="form-group">
                                        <label>
                                            Locality 
                                        </label>
                                        <label id="lblAuthLocality" class="form-label"></label>
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            City / Town / Village
                                        </label>
                                        <label id="lblAuthCity" class="form-label"></label>
                                    </div>
