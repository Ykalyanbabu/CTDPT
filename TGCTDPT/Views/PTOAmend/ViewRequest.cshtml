                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Locality 
                                        </label>
                                        <label id="lblLocalityKey" class="form-label"></label>
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            City / Town / Village 
                                        </label>
