                                        <label id="lblEmailEnter"></label>
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Mobile Number 
                                        </label>
                                        <label id="lblMobileEnter"></label>
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Door Number 
                                        </label>
                                        <label id="lblDoorNoEnter"></label>
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            Road / Street / Building Name 
                                        </label>
                                        <label id="lblRoadEnter"></label>
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            Locality
                                        </label>
                                        <label id="lblLocalityEnter"></label>
                                    </div>

                                    <div class="form-group">
                                        <label>
