                    <div id="divDocuments" class="container mt-4" style="display:block;">
                        <div class="card">
                            <h6 class="text-primary mb-3">Uploaded Documents List</h6>
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover align-middle" id="DocumentsTable" style="font-size: small;">
                                    <thead class="table-light" style="text-align: center;">
                                        <tr>
