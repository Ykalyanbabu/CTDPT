                                        <label>
                                            Number Of Employees Earning Below 15000 per month 
                                        </label>
                                        <label id="lblBelow"></label>
                                        <br />
                                        <label>
                                            Number Of Employees Earning between 15001 to 20000 per month 
                                        </label>
                                        <label id="lblBetween"></label>

                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Number Of Employees Earning above 20000 per month 
                                        </label>
