
@{
    ViewBag.Title = "Amendment Request";
    Layout = "~/Views/Shared/_InnerLayout.cshtml";
}

<head>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', 'Inter', system-ui, -apple-system, 'Roboto', sans-serif;
        }

        body {
            background: #eef2f5;
            min-height: 100vh;
        }

        /* Main layout wrapper */
        .app-container {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ========= MAIN CONTENT LAYOUT ========= */
        .main-dashboard {
            display: flex;
            flex: 1;
            /*padding: 0rem 2rem;*/
            gap: 2rem;
            flex-wrap: wrap;
        }

        /* ========= MAIN CARD (CHECKBOX DYNAMIC PANEL) ========= */
        .checkbox-panel {
            flex: 3;
            min-width: 320px;
            background: white;
            border-radius: 1.2rem;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
            overflow: hidden;
            transition: all 0.2s;
            border: 1px solid #eef2f9;
        }

        .panel-header {
            background: linear-gradient(135deg, #6a1b9a 0%, #9c27b0 60%, #ab47bc 100%);
            padding: 1.2rem 1.8rem;
            border-bottom: 1px solid #e2edf2;
        }

            .panel-header h2 {
                font-size: 1.5rem;
                color: white;
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 0.6rem;
                justify-content: space-around;
            }

                .panel-header h2 span {
                    background: #d4a11e20;
                    padding: 0.2rem 0.6rem;
                    font-size: 0.8rem;
                    border-radius: 30px;
                    color: #8b6b0e;
                }

        .instruction {
            font-size: 0.8rem;
            color: #4b6a78;
            margin-top: 0.5rem;
        }

        /* summary bar - tax department style */
        .summary-tax {
            background: #fef7e0;
            padding: 0.8rem 1.8rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.8rem;
            border-bottom: 1px solid #f0e3c2;
        }

        .selected-counter {
            background: #0b3b2f;
            color: white;
            padding: 0.3rem 1.2rem;
            border-radius: 40px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .selected-items-text {
            font-size: 0.8rem;
            color: #2c4a2e;
            font-weight: 500;
            max-width: 65%;
            white-space: nowrap;
            overflow-x: auto;
            padding-bottom: 2px;
        }

        /* TWO COLUMN CHECKBOX GRID */
        .dynamic-grid {
            padding: 1.8rem;
        }

        .grid-row {
            display: flex;
            flex-wrap: wrap;
            gap: 1.2rem;
            margin-bottom: 1.2rem;
        }

        .checkbox-card {
            flex: 1 1 calc(50% - 0.8rem);
            background: #ffffff;
            border: 1px solid #e4e9f0;
            border-radius: 1rem;
            padding: 0.7rem 1rem;
            display: flex;
            align-items: center;
            transition: all 0.2s;
            cursor: pointer;
            box-shadow: 0 1px 2px rgba(0,0,0,0.02);
        }

            .checkbox-card:hover {
                background: #fafeff;
                border-color: #bbd4c9;
                transform: translateY(-1px);
                box-shadow: 0 6px 12px rgba(0, 0, 0, 0.03);
            }

            .checkbox-card input[type="checkbox"] {
                appearance: none;
                -webkit-appearance: none;
                width: 1.25rem;
                height: 1.25rem;
                border: 2px solid #b9c8d0;
                border-radius: 0.35rem;
                margin-right: 0.9rem;
                position: relative;
                cursor: pointer;
                background: white;
                transition: 0.1s;
                flex-shrink: 0;
            }

                .checkbox-card input[type="checkbox"]:checked {
                    background-color: #1f6e52;
                    border-color: #1f6e52;
                }

                    .checkbox-card input[type="checkbox"]:checked::after {
                        content: "✔";
                        font-size: 0.75rem;
                        font-weight: bold;
                        color: white;
                        position: absolute;
                        top: 50%;
                        left: 50%;
                        transform: translate(-50%, -50%);
                    }

            .checkbox-card label {
                font-size: 0.9rem;
                font-weight: 500;
                color: #1f2f3a;
                cursor: pointer;
                flex: 1;
                letter-spacing: -0.2px;
            }

            .checkbox-card input:checked + label {
                color: #0f5e48;
                font-weight: 600;
            }

        /* action buttons */
        .action-buttons {
            padding: 0.2rem 1.8rem 1.8rem 1.8rem;
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            /*border-top: 1px solid #ecf3e8;*/
            margin-top: -1.5rem;
            justify-content: space-around;
        }

        .btn {
            border: none;
            padding: 0.55rem 1.3rem;
            border-radius: 2rem;
            font-weight: 600;
            font-size: 0.8rem;
            cursor: pointer;
            transition: 0.2s;
            background: #f1f4f9;
            color: #1f3b44;
        }

        .btn-primary {
            background: #0b3b2f;
            color: white;
            box-shadow: 0 2px 6px rgba(11,59,47,0.2);
        }

            .btn-primary:hover {
                background: #1b5e4a;
                transform: translateY(-1px);
            }

        .btn-outline {
            background: white;
            border: 1px solid #cbdde2;
        }

            .btn-outline:hover {
                background: #eef3f6;
            }

        .btn-warning {
            background: #fff1e0;
            color: #aa6f20;
        }

            .btn-warning:hover {
                background: #ffe2bf;
            }

        /* footer */
        .dept-footer {
            background: #132e27;
            color: #cbd5d1;
            text-align: center;
            padding: 0.9rem;
            font-size: 0.7rem;
            margin-top: auto;
        }

        @@media (max-width: 750px) {
            .main-dashboard {
                padding: 1.2rem;
            }

            .selected-items-text {
                white-space: normal;
                max-width: 100%;
            }

            .checkbox-card {
                flex: 1 1 100%;
            }

            .gov-header {
                flex-direction: column;
                text-align: center;
                gap: 8px;
            }

            .datetime-area {
                text-align: center;
            }
        }

        .card {
            max-width: 1100px !important;
            margin: 0px auto;
            padding: 25px;
            /*border: 2px solid #374151;
            border-radius: 6px;*/
            background: #ffffff;
        }

            .card h5.text-primary {
                font-weight: 600 !important;
                border-left: 4px solid #690376;
                padding-left: 10px;
                color: blue;
            }
    </style>
</head>
<body>
    <div class="app-container">
        <div class="main-dashboard">
            <div class="checkbox-panel">
                <div class="panel-header">
                    <h2>Registration Amendment Request</h2>
                    @*<div class="instruction"></div>*@
                </div>
                @*<div class="summary-tax">
                        <div class="selected-counter" id="counterDynamic">0 selected</div>
                        <div class="selected-items-text" id="selectedListDynamic">📌 No tasks selected</div>
                    </div>*@
                <div class="dynamic-grid" id="checkboxGrid"></div>
                <div class="action-buttons">
                    <button class="btn btn-primary" id="btnProceed" onclick="OnProceed();">Proceed</button>
                    <button class="btn btn-primary" id="btnBack" style="display: none; background-color: brown;" onclick="OnBack();">Back</button>
                </div>
                <div id="DivEntryPannel" style="display:none;">
                    <div class="text-center mb-4" id="divRuleBanner" style="display:none;">
                        <h5 class="fw-bold text-primary" style="color: blue;">Form I and Form II </h5>
                        <h6>See Section 6 Read with Rule 3(1) and Rule 4(1)</h6>

                        <h6>
                            Application for Registration and Certificate for Enrolment/Revision of Certificate of Enrolment <br />
                            Under the Telangana Professions,Trades,Callings and Employement Act,1987
                        </h6>
                    </div>

                    <div id="divBusiness" class="container mt-4" style="display: none;">
                        <div class="card">
                            <!-- Step -->
                            <!--<span class="badge bg-secondary mb-3">Step 1</span>-->
                            <!-- Title -->

                            <form>
                                <h5 class="mt-2 mb-2 text-primary">Enterprise Name and Details</h5>
                                <hr />
                                <div class="form-grid">
                                    <div class="form-group">
                                        <label>
                                            Division <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-control" id="bz_division">
                                            <option value="">--Select-- </option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Circle <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-control" id="bz_circle">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Name of the Enterprise/Individual <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="enterprise_name" class="form-control">
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            PAN (Business) <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="business_pan" maxlength="10" class="form-control" onblur="ValidatePAN(this), CheckPAN();" style="text-transform:uppercase;">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Constitution of Business <span class="text-danger">*</span>
                                        </label>

                                        <select class="form-control" id="cobz" onclick="onChangeCobz();">
                                            <option value="">--Select--</option>
                                            <option value="Proprietorship">Proprietorship/Individual</option>
                                            <option value="Partnership">Partnership</option>
                                            <option value="PLC">Private Limited Company</option>
                                            <option value="LLP">Limited Liability Partnership (LLP)</option>
                                            <option value="PSU">Public Sector Undertaking</option>
                                            <option value="Society">Society</option>
                                            <option value="Trust">Trust</option>
                                            <option value="Government">Government Department</option>
                                        </select>
                                    </div>
                                    <div class="form-group" style="display:none;">
                                        <label>
                                            TAN (Business)
                                        </label>
                                        <input type="text" class="form-control">
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            Email <span class="text-danger">*</span>
                                        </label>

                                        <input type="email" id="email_id" class="form-control" style="text-transform: lowercase;">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Mobile Number <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="mobile_no" class="form-control">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Door Number <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="door_no" class="form-control">
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            Road / Street / Building Name <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="road_street" class="form-control">
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            Locality <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="locality" class="form-control">
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            City / Town / Village <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="city" class="form-control">
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            Mandal / Municipality <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="mandal" class="form-control">
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            District <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-control" id="district">
                                            <option value=""> </option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            PIN <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="pincode" class="form-control" min="6" max="6" onkeypress="return isNumber(event)">
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div id="divEmployee" class="container mt-4" style="display:none;">
                        <div class="card">
                            <form>
                                <h5 class="mt-2 mb-2 text-primary">Employee Details</h5>
                                <hr />
                                <div class="form-group" style="width:150%">
                                    <label style="margin-top: 15px;">
                                        <b>
                                            Do you have Employees?
                                        </b> <span class="text-danger">*</span>
                                    </label>
                                    <div>
                                        <label for="rdbYes">
                                            <input type="radio" id="chkisEmp" onchange="fn_chkisEmp(this.value);" name="rdb_isemp" value="Yes"> Yes
                                        </label>
                                        <label for="rdbNo" style="margin-left:15px;">
                                            <input type="radio" id="chkisEmp" name="rdb_isemp" onchange="fn_chkisEmp(this.value);" value="No"> No
                                        </label>
                                    </div>
                                </div>
                                <div class="form-grid" style="display: none; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;" id="divIsEmp">
                                    <div class="form-group">
                                        <label>
                                            Number Of Employees Earning Below 15000 per month <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" min="10" max="10" id="emp_below_15000" class="form-control" style="width:50%;" onkeypress="return isNumber(event)">
                                        <br />
                                        <label>
                                            Number Of Employees Earning between 15001 to 20000 per month <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" min="10" max="10" id="emp_between_15001_20000" class="form-control" style="width:50%;" onkeypress="return isNumber(event)">

                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Number Of Employees Earning above 20000 per month <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" min="10" max="10" id="emp_above_20000" class="form-control" style="width:50%;" onkeypress="return isNumber(event)">
                                        <br />
                                        <label>
                                            Total Number Of Employees Working <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" min="10" max="10" id="tot_emp" class="form-control" style="width:50%;" onkeypress="return isNumber(event)" readonly>
                                    </div>
                                    <br />
                                </div>
                            </form>
                        </div>
                    </div>
                    <div id="divKeyDetails" class="container mt-4" style="display:none;">
                        <div class="card">
                            <form>
                                <h5 class="mt-2 mb-2 text-primary">Owner/Proprietor/Managing Director/Managing Partner/Chairman/Professional Details </h5>
                                <hr />
                                <div class="form-grid">
                                    <div class="form-group">
                                        <label>
                                            Name  <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="O_owner_name" class="form-control">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Father Name <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="O_father_name" class="form-control">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Status of the Individual <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="O_status_of_individual" class="form-control" readonly>
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Email <span class="text-danger">*</span>
                                        </label>
                                        <input type="email" id="O_email_id" class="form-control" style="text-transform: lowercase;">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Door Number <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="O_door_no" class="form-control">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Road / Street / Building Name <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="O_road_street" class="form-control">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Locality <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="O_locality" class="form-control">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            City / Town / Village <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="O_city" class="form-control">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Mandal / Municipality <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="O_mandal" class="form-control">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Country <span class="text-danger"></span>
                                        </label>
                                        <select class="form-control" id="O_country" onchange="onOwnerConutryChange();">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                    <div class="form-group" id="divOwnerState">
                                        <label>
                                            State <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-control" id="O_state_name" onchange="onOwnerStateChange();">
                                            <option value="">--Select--</option>
                                        </select>
                                    </div>
                                    <div class="form-group" id="divOwnerDist">
                                        <label>
                                            District <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-control select" id="O_distict">
                                            <option value="">--Select--</option>
                                        </select>
                                        <input type="text" class="form-control" id="txtOwnerDist" style="display:none;">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            PIN <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control" maxlength="6" minlength="6" id="O_pincode" onkeypress="return isNumber(event)">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            PAN(Owner) <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" class="form-control" maxlength="10" minlength="10" id="O_pan" onblur="ValidatePAN(this);" style="text-transform:uppercase;">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Aadhaar <span class="text-danger"></span>
                                        </label>
                                        <input type="text" maxlength="12" id="O_aadhaar" class="form-control" minlength="12" onblur="ValidateAadhaar(this);" onkeypress="return isNumber(event)">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Mobile Number <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="O_mobile_no" maxlength="10" minlength="10" class="form-control" onkeypress="return isNumber(event)">
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div id="divAuthPerson" class="container mt-4" style="display:none;">
                        <div class="card">
                            <form>
                                <h5 class="mt-2 mb-2 text-primary">Authorised Person Details</h5>
                                <hr />
                                <div class="form-group" style="width:150%">
                                    <label style="margin-top: 15px;">
                                        <b>
                                            Have you Nominated any Authorised Person?
                                        </b> <span class="text-danger">*</span>
                                    </label>
                                    <div>
                                        <label for="rdbYes">
                                            <input type="radio" id="chkAuthrisedprsn" onchange="fn_chkAuthorisedprsn(this.value);" name="rdb_auth_prsn" value="Yes"> Yes
                                        </label>
                                        <label for="rdbNo" style="margin-left:15px;">
                                            <input type="radio" id="chkAuthrisedprsn" name="rdb_auth_prsn" onchange="fn_chkAuthorisedprsn(this.value);" value="No"> No
                                        </label>
                                    </div>
                                </div>
                                <div class="form-grid" id="divAuthorised">
                                    <div class="form-group">
                                        <label>
                                            Name  <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="auth_name" class="form-control" value="">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Father Name <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="auth_fname" class="form-control" value="">
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            Email <span class="text-danger">*</span>
                                        </label>
                                        <input type="email" id="auth_email" class="form-control" style="text-transform: lowercase;">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Door Number <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="auth_door_no" class="form-control">
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            Road / Street / Building Name <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="auth_road_street" class="form-control">
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            Locality <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="auth_locality" class="form-control">
                                    </div>

                                    <div class="form-group">
                                        <label>
                                            City / Town / Village <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="auth_city" class="form-control">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            District <span class="text-danger">*</span>
                                        </label>
                                        <select class="form-control" id="auth_district">
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            PIN <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="auth_pincode" maxlength="6" minlength="6" class="form-control" onkeypress="return isNumber(event)">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            PAN <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="auth_pan" maxlength="10" minlength="10" onblur="ValidatePAN(this);" class="form-control" style="text-transform:uppercase;">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Aadhaar <span class="text-danger"></span>
                                        </label>
                                        <input type="text" id="auth_aadhaar" maxlength="12" minlength="12" class="form-control" onblur="ValidateAadhaar(this);" onkeypress="return isNumber(event)">
                                    </div>
                                    <div class="form-group">
                                        <label>
                                            Mobile Number <span class="text-danger">*</span>
                                        </label>
                                        <input type="text" id="auth_mobile_no" maxlength="10" minlength="10" class="form-control" onkeypress="return isNumber(event)">
                                    </div>

