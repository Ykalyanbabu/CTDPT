            var IsPartnerShow = "";
            function onChangeCobz() {
                var CobzType = $('#cobz').val();
                var StausOfIndiviual = "";

                switch (CobzType) {
                    case "Proprietorship":
                        StausOfIndiviual = "Proprietor / Individual";
                        break;
                    case "Partnership":
                        StausOfIndiviual = "Managing Partner";
                        break;
                    case "PLC":
                        StausOfIndiviual = "Managing Director";
                        break;
                    case "LLP":
                        StausOfIndiviual = "Managing Director";
                        break;
                    case "PSU":
                        StausOfIndiviual = "Managing Director / Chairman";
                        break;
                    case "Society":
                        StausOfIndiviual = "Chairman";
                        break;
                    case "Trust":
                        StausOfIndiviual = "Chairman";
                        break;
                    case "Government":
                        StausOfIndiviual = "HOD of the Office / DDO";
                        break;
                    default:
                        StausOfIndiviual = "";
                        break;
                }
                $('#O_status_of_individual').val(StausOfIndiviual);
                if (CobzType == "Proprietorship") {
                    IsPartnerShow = "N";
                    $('#divYesPartners').hide();
                    $('#divNoPartners').show();
                    $('#btnAddPartner').hide();
                    $('#divPartnerstable').hide();
                    $('#hdr1').hide();
                }
                else {
                    IsPartnerShow = "Y";
                    $('#divYesPartners').show();
                    $('#divNoPartners').hide();
                    $('#btnAddPartner').show();
                    $('#divPartnerstable').show();
                    $('#hdr1').show();
                }
            }

