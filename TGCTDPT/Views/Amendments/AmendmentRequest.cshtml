        function validate_mobile() {

            var mob = document.getElementById("O_mobile_no");
            var value = mob.value.trim();

            if (!/^[0-9]{10}$/.test(value)) {
                mob.style.border = "1px solid red";
                alert("mobile number must be 10 digits");
                return false;
            }

            mob.style.border = "";
            return true;
        }
            function validate_pincode() {

                var pin = document.getElementById("O_pincode");
                var value = pin.value.trim();

                if (!/^[0-9]{6}$/.test(value)) {
                    pin.style.border = "1px solid red";
                    alert("pincode must be 6 digits");
                    return false;
                }

                pin.style.border = "";
                return true;
            }
            function validate_aadhaar() {

                var aadhaar = document.getElementById("O_aadhaar");
                var value = aadhaar.value.trim();

                if (value === "") return true; // optional field

                if (!/^[0-9]{12}$/.test(value)) {
                    aadhaar.style.border = "1px solid red";
                    alert("aadhaar must be 12 digits");
                    return false;
                }

                aadhaar.style.border = "";
                return true;
            }



            function validate_O_pan() {

                var regpan = document.getElementById("O_pan");
                var panPattern = /^[A-Z]{5}[0-9]{4}[A-Z]{1}$/;

                var panInput = regpan.value.trim().toUpperCase();
                regpan.value = panInput; // force uppercase

                if (!panPattern.test(panInput)) {
                    regpan.style.border = "1px solid red";
                    alert("invalid pan format");
                    return false;
                }

                regpan.style.border = "";
                return true;
            }
