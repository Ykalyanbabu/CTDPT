        function validate_document() {

            var formData = new FormData();

            if ($('#DocumentsTable tbody tr').length === 0) {
                ModernAlert.toast.info('Please upload at least one document');
                return false;
            }

            let i = 0;
            let isValid = true;

            documentList.forEach(function (item, index) {

                if (item != null) {

                    if (!item.document_type) {
                        alert("File missing at row " + (index + 1));
                        isValid = false;
                        return false;
                    }

                    formData.append("model[" + i + "].master_doc_id", item.master_docid);
                    formData.append("model[" + i + "].document_type", item.document_type);
                    formData.append("model[" + i + "].document_path", item.document_path || "");

                    if (item.file) {
                        formData.append("files[" + i + "]", item.file);
                    }

                    i++;
                }
            });

            if (!isValid) return;

            if (i === 0) {
                ModernAlert.toast.info('No valid documents to upload');
                return;
            }

            $.ajax({
                url: '@Url.Action("Save_Documents", "Registration")',
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        ModernAlert.toast.success('Documents saved successfully');
                        showTab("8");
                    } else {
                        ModernAlert.toast.info(res.message || 'Failed to save documents');
                        showTab("7");
                    }
                },
                error: function () {
                    ModernAlert.toast.info('Error while uploading documents');
                }
            });
        }

