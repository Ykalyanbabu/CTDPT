    <script src="~/ViewJs/AmendmentScript.js"></script>
    <script>

            var _Ptin = '@Session["Tin"]';
        var getAppDtlsUrl = '@Url.Action("GetApplicationDtls", "Amendments")';
        var SaveUrl = '@Url.Action("SubmitAmendment", "Amendments")';
        var HomeUrl = '@Url.Action("Dashboard", "PTHome")';

        let gridContainer = document.getElementById('checkboxGrid');
        const counterSpan = document.getElementById('counterDynamic');
        const selectedSpan = document.getElementById('selectedListDynamic');

        function renderDynamicGrid() {
            if (!gridContainer) return;
            gridContainer.innerHTML = '';
            const itemCount = Amendments.length;
            const rows = Math.ceil(itemCount / 2);
            let pointer = 0;

            for (let i = 0; i < rows; i++) {
                const rowDiv = document.createElement('div');
                rowDiv.className = 'grid-row';

                // first checkbox of row
                if (pointer < itemCount) {
                    const item1 = Amendments[pointer];
                    const chkDiv1 = createCheckboxCard(item1, pointer);
                    rowDiv.appendChild(chkDiv1);
                    pointer++;
                }
                // second checkbox of row
                if (pointer < itemCount) {
                    const item2 = Amendments[pointer];
                    const chkDiv2 = createCheckboxCard(item2, pointer);
                    rowDiv.appendChild(chkDiv2);
                    pointer++;
                }
                gridContainer.appendChild(rowDiv);
            }
        }

        function createCheckboxCard(item, idx) {
            const card = document.createElement('div');
            card.className = 'checkbox-card';

            const cb = document.createElement('input');
            cb.type = 'checkbox';
            cb.id = `amnd_chk_${item.amendment_type_id}`;
            cb.checked = item.checked;

            const label = document.createElement('label');
            label.htmlFor = `amnd_chk_${item.amendment_type_id}`;
            label.textContent = item.amendment_type_name;

            card.appendChild(cb);
            card.appendChild(label);

            cb.addEventListener('change', (e) => {
                item.checked = e.target.checked;
                onCheckAmendment(item.amendment_type_id, item.checked);
            });

            card.addEventListener('click', (e) => {
                if (e.target.tagName !== 'INPUT') {
                    const checkInput = card.querySelector('input');
                    if (checkInput) {
                        checkInput.checked = !checkInput.checked;
                        const changeEvent = new Event('change', { bubbles: true });
                        checkInput.dispatchEvent(changeEvent);
                    }
                }
            });

            return card;
        }

        document.addEventListener('DOMContentLoaded', () => {
            renderDynamicGrid();

            const selectBtn = document.getElementById('selectAllBtn');
            const clearBtn = document.getElementById('clearAllBtn');
            const resetBtn = document.getElementById('resetDefaultBtn');

            if (selectBtn) selectBtn.addEventListener('click', selectAll);
            if (clearBtn) clearBtn.addEventListener('click', clearAll);
            if (resetBtn) resetBtn.addEventListener('click', resetDefault);

        });


        var Amendments = [];
        $(document).ready(function () {
            getAmendments();
            LoadApplicationDtls(_Ptin);
            Load_Banks();
        });

        function getAmendments() {
            $.ajax({
                url: '@Url.Action("GetAmendments", "Amendments")',
                dataType: 'json',
                success: function (response) {
                    if (response.length > 0) {
                        Amendments = response;
                        renderDynamicGrid();
                    }
                    else {

                    }
                },
                error: function (error) {
                    console.error(error);
                }
            });
        }
        var CheckBuz = "";
        var CheckEmp = "";
        var CheckKeyPerson = "";
        var CheckAuth = "";
        var CheckPartners = "";
        var CheckBranches = "";
        var CheckBank = "";
        function onCheckAmendment(id, status) {
            const checkedCount = $('.dynamic-grid input:checkbox:checked').length;
            if (checkedCount > 0) {
                $('#divRuleBanner').show();
            }
            else {
                $('#divRuleBanner').hide();
            }
            fn_chkAdditionalPlace();
            fn_chkAuthorisedprsn();
            if (id == "1") {
                if (status) {
                    $('#divBusiness').show();
                    CheckBuz = "Y";
                }
                else {
                    $('#divBusiness').hide();
                    CheckBuz = "N";
                }
            }
            if (id == "2") {
                if (status) {
                    $('#divEmployee').show();
                    CheckEmp = "Y";
                }
                else {
                    $('#divEmployee').hide();
                    CheckEmp = "N";
                }
            }
            if (id == "3") {
                if (status) {
                    $('#divKeyDetails').show();
                    CheckKeyPerson = "Y";
                }
                else {
                    $('#divKeyDetails').hide();
                    CheckKeyPerson = "N";
                }
            }
            if (id == "4") {
                if (status) {
                    $('#divAuthPerson').show();
                    CheckAuth = "Y";
                }
                else {
                    $('#divAuthPerson').hide();
                    CheckAuth = "N";
                }
            }
            if (id == "5") {
                if (status) {
                    $('#divPartnerDirector').show();
                    CheckPartners = "Y";
                }
                else {
                    $('#divPartnerDirector').hide();
                    CheckPartners = "N";
                }
            }
            if (id == "6") {
                if (status) {
                    $('#divAdditionalPlace').show();
                    CheckBranches = "Y";
                }
                else {
                    $('#divAdditionalPlace').hide();
                    CheckBranches = "N";
                }
            }
            if (id == "7") {
                if (status) {
                    $('#divBankDtls').show();
                    CheckBank = "Y";
                }
                else {
                    $('#divBankDtls').hide();
                    CheckBank = "N";
                }
            }
        }
        function fn_chkisEmp() {
            if ($('#chkisEmp').is(':checked') == true) {
                $('#divIsEmp').show();
            }
            else {
                $('#divIsEmp').hide();
            }
        }
        function fn_chkAuthorisedprsn() {
            if ($('#chkAuthrisedprsn').is(':checked') == true) {
                $('#divAuthorised').show();
            }
            else {
                $('#divAuthorised').hide();
            }
        }
        function fn_chkAdditionalPlace() {
            if ($('#chkAdditionalPlace').is(':checked') == true) {
                $('#divAddPlace').show();
                $('#h6AddedPlaces').show();
                $('#tblAddedPlaces').show();

            }
            else {
                $('#divAddPlace').hide();
                $('#h6AddedPlaces').hide();
                $('#tblAddedPlaces').hide();
            }
        }
        function OnProceed() {
            const checkedCount = $('.dynamic-grid input:checkbox:checked').length;
            if (checkedCount == 0) {
                ModernAlert.toast.info('Please slect atleast one Amendment Type to Proceed');
                return false;
            }
            $('#btnProceed').hide();
            $('#checkboxGrid').hide();
            $('#btnBack').show();
            $('#DivEntryPannel').show();
        }
        function OnBack() {
            $('#btnBack').hide();
