            $("input[type='text']").eq(0).val(tds.eq(0).text());
            $("input[type='date']").val(tds.eq(1).text());
            $("select").eq(0).val(tds.eq(2).text());
            $("#ddlGender").val(tds.eq(3).text());
            $("input[maxlength='10']").val(tds.eq(4).text());
        });

        let rnrCounter = 1;
        var documentList = [];


        $('#btnUploadDoc').on('click', function () {

            let docId = $('#doc_name').val();
            let docName = $('#doc_name option:selected').text();
            /* let docName = $('#doc_name ').val();*/
            let fileInput = $('#doc_file')[0];

            if (docId === "0") {
                ModernAlert.toast.info('Please select Document to Upload');
                return;
            }

            if (fileInput.files.length === 0) {
                ModernAlert.toast.info('Please select a PDF file');
                return;
            }

            let file = fileInput.files[0];

            if (file.type !== "application/pdf") {
                ModernAlert.toast.info('Only PDF files are allowed');
                $('#doc_file').val('');
                return;
            }

            let obj = {
                master_docid: docId,
                document_type: docName,
                file: file
            };

            documentList.push(obj);

            $('#noDataRowFiles').remove();

            let fileURL = URL.createObjectURL(file);

            let index = documentList.length - 1;

            let row = `
                      <tr data-index="${index}">
                          <td>${rnrCounter}</td>
                          <td>${docName}</td>
                          <td class="text-center">
                           <button class="btn btn-sm btn-primary viewFile same-size-btn" data-url="${fileURL}">
                               View
                           </button>
                         </td>
                         <td class="text-center">
                             <button class="btn btn-sm btn-primary deleteFile same-size-btn" style="background: red;">
                                 Delete
                             </button>
                         </td>
                      </tr>`;

            $('#DocumentsTable tbody').append(row);
            updateSerialNumbers('DocumentsTable');
            $('#doc_name option[value="' + docId + '"]').prop('disabled', true);
            $('#doc_name').val('0');
            $('#doc_file').val('');
        });

        $(document).on('click', '.viewFile', function () {
            let url = $(this).data('url');
            window.open(url, '_blank');
        });
        let deletedDocuments = [];
        $(document).on('click', '.deleteFile', function () {

            if (!confirm("Do you want to delete this file?")) {
                return;
            }
            let row = $(this).closest('tr');
            let index = row.data('index');

            let item = documentList[index];

            if (item && item.document_path && !item.file) {
                deletedDocuments.push(item);
            }

            documentList[index] = null;

            row.remove();
            $('#doc_name option[value="' + item.master_docid + '"]').prop('disabled', false);
            $('#DocumentsTable tbody tr').each(function (i) {
                $(this).find('td:first').text(i + 1);
            });
            updateSerialNumbers('DocumentsTable');
            if ($('#DocumentsTable tbody tr').length === 0) {
                $('#DocumentsTable tbody').append(`
            <tr id="noDataRowFiles">
                <td colspan="5" class="text-center text-muted">No Files added</td>
            </tr>
        `);
            }
        });

